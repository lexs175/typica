---
import Button from "@/components/Button.astro";
import baristaImage from "@/assets/images/barista.avif";
import tostadorImage from "@/assets/images/tostador.avif";
import frame1Sticker from "@/assets/stickers/Frame-1.svg";

interface Props {
  render?: boolean;
}
const { render = true } = Astro.props;
---

{render && (
  <div class="culture-story_wrap">
    <div class="culture-story_stage">
      <div class="culture-story_visual">
        <figure class="culture-story_polaroid culture-story_polaroid-left">
          <div class="culture-story_polaroid-card">
            <img
              src={baristaImage.src}
              alt="Barista de Typica sirviendo leche sobre un café"
              width="1500"
              height="1000"
              loading="lazy"
            />
          </div>
        </figure>
        <figure class="culture-story_polaroid culture-story_polaroid-right">
          <div class="culture-story_polaroid-card">
            <img
              src={tostadorImage.src}
              alt="Granos de café tostados en Typica"
              width="1500"
              height="1000"
              loading="lazy"
            />
          </div>
        </figure>
        <img
          class="culture-story_sticker"
          src={frame1Sticker.src}
          alt="EF RUN CLUB"
          aria-hidden="true"
          width="139"
          height="121"
          loading="lazy"
        />
      </div>

      <div class="culture-story_copy">
        <h3>
          Hay oficio
          <br />
          <em class="culture-story_flourish-wrap">
            Y mucho cariño
            <svg
              class="culture-story_title-flourish"
              viewBox="0 0 403 17"
              fill="none"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path
                class="draw-path"
                pathLength="100"
                d="M1 16C25.8389 14.2222 50.643 12.2137 75.2387 9.47009C107.364 5.99145 144.414 1.26496 174.898 1C178.242 1.35897 168.254 2.8718 166.786 3.22223C163.842 3.76924 160.464 4.41881 157.146 5.11966C152.23 6.22223 134.982 9.64957 144.171 12.1282C152.23 13.8974 167.551 13.4701 178.572 13.094C200.11 12.2393 222.066 10.2137 243.639 8.99146C296.296 5.69231 349.291 6.34188 402 8.58975"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </em>
        </h3>
        <p>
          Manos que seleccionan, tuestan y preparan. Gente que vuelve. Música,
          charlas y planes que se arman alrededor de una taza.
        </p>
        <div class="culture-story_action">
          <Button
            element="link"
            href="https://www.instagram.com/typica.cafe/"
            target="_blank"
            rel="noopener"
          >
            Mira lo que pasa en Typica
          </Button>
        </div>
      </div>
    </div>
  </div>
)}

<style is:global>
  @layer components {
    .culture-story_wrap {
      position: relative;
      background: var(--dark-950);
      color: var(--light-100);
      padding: clamp(6rem, 14svh, 14rem) 6vw clamp(8rem, 16svh, 16rem);
      box-sizing: border-box;
      width: 100%;
      overflow: visible;
    }
    .culture-story_stage {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: clamp(3rem, 7vw, 8rem);
      align-items: center;
      max-width: 82rem;
      margin: 0 auto;
      width: 100%;
    }
    .culture-story_visual {
      position: relative;
      width: 100%;
      max-width: 36rem;
      aspect-ratio: 1 / 1.05;
      margin: 0 auto;
    }
    .culture-story_polaroid {
      position: absolute;
      margin: 0;
      padding: 0;
    }
    .culture-story_polaroid-card {
      background: var(--light-100);
      padding: 0.875rem 0.875rem 2.875rem 0.875rem;
      border-radius: 0.375rem;
      box-shadow: 0 1.25rem 3.5rem var(--shadow-deep);
      border: var(--border-width) solid var(--border-subtle);
      overflow: hidden;
    }
    .culture-story_polaroid-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 0.125rem;
      display: block;
    }
    .culture-story_polaroid-left {
      top: 0;
      left: 0;
      width: 68%;
      transform: rotate(-6deg);
      z-index: 1;
    }
    .culture-story_polaroid-left .culture-story_polaroid-card img {
      aspect-ratio: 3 / 4;
      object-position: 40% 50%;
    }
    .culture-story_polaroid-right {
      bottom: 0;
      right: 0;
      width: 62%;
      transform: rotate(4deg);
      z-index: 2;
    }
    .culture-story_polaroid-right .culture-story_polaroid-card img {
      aspect-ratio: 1 / 1;
      object-position: center;
    }
    .culture-story_sticker {
      position: absolute;
      top: 30%;
      left: 54%;
      transform: translate(-30%, -20%) rotate(8deg);
      width: clamp(6.5rem, 14vw, 10.5rem);
      height: auto;
      z-index: 4;
      pointer-events: none;
      filter: drop-shadow(0 0.5rem 1rem var(--shadow-black));
    }
    .culture-story_copy {
      color: var(--light-100);
    }
    .culture-story_copy h3 {
      font-size: clamp(2.75rem, 5vw, 5.25rem);
      font-weight: 850;
      line-height: 1.05;
      letter-spacing: -0.05em;
      margin: 0;
      color: var(--light-100);
    }
    .culture-story_flourish-wrap {
      position: relative;
      display: inline-block;
      font:
        italic 400 1.08em / 1 "Instrument Serif",
        Georgia,
        serif;
      letter-spacing: -0.02em;
    }
    .culture-story_title-flourish {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      height: 1.25rem;
      margin-top: 0.25rem;
      overflow: visible;
      pointer-events: none;
      color: var(--light-100);
    }
    .culture-story_title-flourish .draw-path {
      will-change: stroke-dashoffset;
    }
    .culture-story_copy > p {
      font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
      line-height: 1.55;
      color: var(--warm-400);
      max-width: 30rem;
      margin: 1.875rem 0 2.25rem;
    }
    .culture-story_action {
      --button-background: var(--light-100);
      --button-text: var(--neutral-900);
      --button-border: var(--neutral-900);
    }
    @media (max-width: 56.25rem) {
      .culture-story_stage {
        grid-template-columns: 1fr;
        gap: 4rem;
      }
      .culture-story_visual {
        max-width: 28rem;
      }
      .culture-story_copy {
        max-width: 32rem;
      }
    }
    @media (max-width: 37.5rem) {
      .culture-story_wrap {
        padding: 5rem 6vw 6rem;
      }
      .culture-story_copy h3 {
        font-size: 11vw;
      }
      .culture-story_copy > p {
        font-size: 1rem;
        margin: 1.25rem 0 1.75rem;
      }
    }
  }
</style>
