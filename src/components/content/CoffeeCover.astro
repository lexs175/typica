---
import CoffeeLetter from "@/components/item/CoffeeLetter.astro";
import tostadorImage from "@/assets/images/tostador.avif";
import baristaImage from "@/assets/images/barista.avif";
import sticker100 from "@/assets/stickers/sticker-100.svg";
import frame1Sticker from "@/assets/stickers/Frame-1.svg";
import frame2Sticker from "@/assets/stickers/Frame-2.svg";
import frame3Sticker from "@/assets/stickers/Frame-3.svg";
import coffeeSticker from "@/assets/stickers/coffee.svg";
import truus17Sticker from "@/assets/stickers/truus.co-17.svg";
import truus4Sticker from "@/assets/stickers/truus.co-4.svg";
import truus12Sticker from "@/assets/stickers/truus.co-12.svg";
import truus51Sticker from "@/assets/stickers/truus.co-51.svg";
import frame4Sticker from "@/assets/stickers/Frame-4.svg";

interface Props {
  render?: boolean;
}
const { render = true } = Astro.props;
---

{render && (
  <div class="coffee-cover_wrap">
    <h2 class="sr-only" id="coffee-scene-title">
      Café en bolsa. De Bolivia a tu primera taza.
    </h2>

    <div class="coffee-cover_container">
      {/* Grid Principal: CAFÉ EN BOLSA (7 columnas exactas pegado de borde a borde) */}
      <div class="coffee-cover_layout">
        {/* Fila 1 */}
        <button
          class="coffee-cover_cell coffee-cover_arrow ph-r1c1"
          type="button"
          data-coffee-browse=""
          aria-label="Explorar los cafés"
        >
          <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <path
              d="M5 16h21M17 6l10 10-10 10"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </button>

        <CoffeeLetter letter="C" color="--pink-500" class="ph-r1c2" sticker={frame1Sticker} />
        <CoffeeLetter letter="A" color="--brand-500" class="ph-r1c3" sticker={frame2Sticker} />
        <CoffeeLetter letter="F" color="--mint-300" class="ph-r1c4" sticker={frame3Sticker} />
        <CoffeeLetter letter="É" color="--rose-300" class="ph-r1c5" sticker={coffeeSticker} />

        {/* Foto 1 (Tostador con EN): 2 columnas de ancho x 1 fila de alto (rectángulo 2:1 perfecto) */}
        <figure class="coffee-cover_cell coffee-cover_photo coffee-cover_photo-top ph-r1c67">
          <img
            src={tostadorImage.src}
            alt="El oficio del tueste en Typica"
            width="1500"
            height="1000"
            loading="lazy"
          />
          <span aria-hidden="true">EN</span>
        </figure>

        {/* Fila 2 & 3: Barista en Columna 1 (1 columna de ancho x 2 filas de alto: rectángulo 1:2 vertical perfecto) */}
        <figure class="coffee-cover_cell coffee-cover_photo coffee-cover_photo-tall ph-r2c1">
          <img
            src={baristaImage.src}
            alt="Una barista de Typica, del café a la taza"
            width="1500"
            height="1000"
            loading="lazy"
          />
        </figure>

        <CoffeeLetter letter="B" color="--pink-500" class="ph-r2c2" sticker={truus17Sticker} />
        <CoffeeLetter letter="O" color="--brand-500" class="ph-r2c3" sticker={truus4Sticker} />
        <CoffeeLetter letter="L" color="--mint-300" class="ph-r2c4" sticker={truus12Sticker} />
        <CoffeeLetter letter="S" color="--rose-300" class="ph-r2c5" sticker={truus51Sticker} />
        <CoffeeLetter letter="A" color="--pink-500" class="ph-r2c6" sticker={frame4Sticker} />

        {/* Fila 3: Mensaje editorial + Sticker 100 (columnas 2 a 7 en fila 3) */}
        <div class="coffee-cover_message ph-r3c27">
          <p class="coffee-cover_motto">
            De Bolivia<br />a tu primera taza.
          </p>
          <div class="coffee-cover_sticker-100" aria-hidden="true">
            <img
              src={sticker100.src}
              alt=""
              width="155"
              height="155"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
)}

<style is:global>
  @layer components {
    /* =========================================================
       PANEL IZQUIERDO COVER: EXACTAMENTE 100vw (PANTALLA COMPLETA)
       FONDO PERIWINKLE / LILA #E8EAFA - CERO SOMBRAS
       GRID DE 7 COLUMNAS Y 3 FILAS PEGADO DE BORDE A BORDE
       TODAS LAS CELDAS BASE SON CUADRADOS PERFECTOS (1:1)
       ========================================================= */
    :root {
      --cover-gap: clamp(6px, 0.7vw, 14px);
      --cover-cell: calc((100vw - 6 * var(--cover-gap)) / 7);
    }

    .coffee-cover_wrap {
      width: 100vw !important;
      min-width: 100vw !important;
      max-width: 100vw !important;
      flex: 0 0 100vw !important;
      height: 100svh;
      min-height: 100svh;
      background-color: #ffffff;
      padding: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: stretch;
      box-sizing: border-box;
      box-shadow: none !important;
      overflow: hidden;
    }

    .coffee-cover_container {
      width: 100vw;
      max-width: 100vw;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      box-sizing: border-box;
    }

    .coffee-cover_layout {
      display: grid;
      grid-template-columns: repeat(7, var(--cover-cell));
      grid-template-rows: repeat(3, var(--cover-cell));
      gap: var(--cover-gap);
      width: 100vw;
      box-sizing: border-box;
      align-items: stretch;
      justify-items: stretch;
    }

    .coffee-cover_cell {
      position: relative;
      border-radius: clamp(4px, 0.5vw, 8px);
      overflow: hidden;
      width: 100%;
      height: 100%;
      min-width: 0;
      min-height: 0;
      box-shadow: none !important;
      box-sizing: border-box;
    }

    /* Posicionamiento en Grid según estructura */
    .ph-r1c1 { grid-column: 1; grid-row: 1; }
    .ph-r1c2 { grid-column: 2; grid-row: 1; }
    .ph-r1c3 { grid-column: 3; grid-row: 1; }
    .ph-r1c4 { grid-column: 4; grid-row: 1; }
    .ph-r1c5 { grid-column: 5; grid-row: 1; }

    /* Foto 1 (Tostador con EN): ocupa 2 columnas y 1 fila -> Rectángulo 2:1 exacto sin estirar el grid */
    .ph-r1c67 {
      grid-column: 6 / 8;
      grid-row: 1;
    }

    /* Foto 2 (Barista): ocupa 1 sola columna y filas 2 y 3 -> Rectángulo vertical 1:2 exacto con cuadrados */
    .ph-r2c1 {
      grid-column: 1;
      grid-row: 2 / 4;
    }

    .ph-r2c2 { grid-column: 2; grid-row: 2; }
    .ph-r2c3 { grid-column: 3; grid-row: 2; }
    .ph-r2c4 { grid-column: 4; grid-row: 2; }
    .ph-r2c5 { grid-column: 5; grid-row: 2; }
    .ph-r2c6 { grid-column: 6; grid-row: 2; }

    /* Fila 3: Mensaje editorial + Sticker 100 (columnas 2 a 7 en fila 3) */
    .coffee-cover_message {
      grid-column: 2 / 8;
      grid-row: 3;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 100%;
      padding: 0 clamp(0.75rem, 1.5vw, 2.5rem);
      box-sizing: border-box;
      min-width: 0;
      min-height: 0;
    }

    /* Botón amarillo flecha -> */
    .coffee-cover_arrow {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      background: #FFE42F;
      color: #000000;
      cursor: pointer;
      border: none;
      border-radius: clamp(4px, 0.5vw, 8px);
      box-shadow: none !important;
      transition: transform 160ms ease;
    }
    @media (hover: hover) {
      .coffee-cover_arrow:hover {
        transform: scale(0.96);
      }
    }
    .coffee-cover_arrow svg {
      width: 58%;
      height: 58%;
    }

    .coffee-cover_photo {
      position: relative;
      margin: 0;
      border-radius: clamp(4px, 0.5vw, 8px);
      overflow: hidden;
      background: #000000;
      width: 100%;
      height: 100%;
    }
    .coffee-cover_photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      border-radius: clamp(4px, 0.5vw, 8px);
    }

    /* Foto superior con texto EN */
    .coffee-cover_photo-top {
      position: relative;
    }
    .coffee-cover_photo-top::after {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
    }
    .coffee-cover_photo-top span {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: grid;
      place-items: center;
      color: #ffffff;
      font-family: var(--font-headline);
      font-weight: 900;
      font-size: calc(var(--cover-cell) * 0.72);
      line-height: 1;
      letter-spacing: -0.05em;
    }

    .coffee-cover_photo-tall img {
      object-position: 55% center;
    }

    /* Motto editorial y sticker 100 */
    .coffee-cover_motto {
      font-family: var(--font-headline);
      font-weight: 900;
      font-size: clamp(1.1rem, 2.3vw, 2.75rem);
      line-height: 1.1;
      letter-spacing: -0.04em;
      color: #090909;
      margin: 0;
    }

    .coffee-cover_sticker-100 {
      height: 72%;
      max-height: calc(var(--cover-cell) * 0.75);
      width: auto;
      transform: rotate(9deg);
      flex-shrink: 0;
      filter: none !important;
      box-shadow: none !important;
    }
    .coffee-cover_sticker-100 img {
      height: 100%;
      width: auto;
      object-fit: contain;
      display: block;
    }

    /* =========================================================
       RESPONSIVE TABLET & MOBILE (< 1024px)
       PORTADA 6 COLUMNAS CON FOTO BARISTA COMPLETA (FIGMA)
       ========================================================= */
    @media (max-width: 1023px) {
      .coffee-cover_wrap {
        width: 100% !important;
        min-width: 100% !important;
        max-width: 100% !important;
        flex: none !important;
        height: auto !important;
        min-height: auto !important;
        padding: clamp(16px, 3.5vw, 40px) clamp(16px, 3.5vw, 40px) clamp(24px, 4vw, 48px) !important;
        background-color: #ffffff;
      }

      .coffee-cover_container {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
      }

      .coffee-cover_layout {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        grid-template-rows: auto auto auto;
        gap: clamp(6px, 1.2vw, 12px);
        width: 100%;
      }

      /* Fila 1: C · A · F · É · EN (foto tostador en 2 columnas) */
      .ph-r1c2 {
        grid-column: 1;
        grid-row: 1;
        aspect-ratio: 1 / 1;
      }
      .ph-r1c3 {
        grid-column: 2;
        grid-row: 1;
        aspect-ratio: 1 / 1;
      }
      .ph-r1c4 {
        grid-column: 3;
        grid-row: 1;
        aspect-ratio: 1 / 1;
      }
      .ph-r1c5 {
        grid-column: 4;
        grid-row: 1;
        aspect-ratio: 1 / 1;
      }
      .ph-r1c67 {
        grid-column: 5 / 7;
        grid-row: 1;
        aspect-ratio: 2 / 1;
        width: 100%;
        height: 100%;
      }

      /* Fila 2: ➔ (Amarillo) · B · O · L · S · A */
      .ph-r1c1 {
        grid-column: 1;
        grid-row: 2;
        aspect-ratio: 1 / 1;
        background: #FFE42F;
        color: #000000;
        display: grid;
        place-items: center;
        border-radius: clamp(4px, 0.8vw, 8px);
      }
      .ph-r2c2 {
        grid-column: 2;
        grid-row: 2;
        aspect-ratio: 1 / 1;
      }
      .ph-r2c3 {
        grid-column: 3;
        grid-row: 2;
        aspect-ratio: 1 / 1;
      }
      .ph-r2c4 {
        grid-column: 4;
        grid-row: 2;
        aspect-ratio: 1 / 1;
      }
      .ph-r2c5 {
        grid-column: 5;
        grid-row: 2;
        aspect-ratio: 1 / 1;
      }
      .ph-r2c6 {
        grid-column: 6;
        grid-row: 2;
        aspect-ratio: 1 / 1;
      }

      /* Fila 3: Foto Barista en ancho completo (las 6 columnas) */
      .ph-r2c1 {
        grid-column: 1 / 7;
        grid-row: 3;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        border-radius: clamp(4px, 0.8vw, 8px);
        overflow: hidden;
      }
      .ph-r2c1 img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 30%;
      }

      /* En tablet la portada de Figma no lleva el banner de texto inferior */
      .coffee-cover_message {
        display: none !important;
      }

      .coffee-cover_photo-top span {
        font-size: clamp(2rem, 9.5vw, 5.5rem);
      }
    }
  }
</style>
