---
import CoffeeLetter from "@/components/item/CoffeeLetter.astro";
import tostadorImage from "@/assets/images/tostador.avif";
import baristaImage from "@/assets/images/barista.avif";
import frameSticker from "@/assets/stickers/Frame.svg";

interface Props {
  render?: boolean;
}
const { render = true } = Astro.props;
---

{render && (
  <div class="coffee-cover_wrap">
    <h2 class="sr-only" id="coffee-scene-title">
      Café en bolsa. De Bolivia a tu casa.
    </h2>
    <div class="coffee-cover_layout">
      <button
        class="coffee-cover_arrow"
        type="button"
        data-coffee-browse=""
        aria-label="Explorar los cafés"
      >
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path
            d="M5 16h21M17 6l10 10-10 10"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
      <CoffeeLetter letter="C" color="--pink-500" />
      <CoffeeLetter letter="A" color="--brand-500" />
      <CoffeeLetter letter="F" color="--mint-300" />
      <CoffeeLetter letter="É" color="--rose-300" />
      <figure class="coffee-cover_photo coffee-cover_photo-top">
        <img
          src={tostadorImage.src}
          alt="El oficio del tueste en Typica"
          width="1500"
          height="1000"
          loading="lazy"
        />
        <span aria-hidden="true">EN</span>
      </figure>
      <figure class="coffee-cover_photo coffee-cover_photo-tall">
        <img
          src={baristaImage.src}
          alt="Una barista de Typica, del café a la taza"
          width="1500"
          height="1000"
          loading="lazy"
        />
      </figure>
      <CoffeeLetter letter="B" color="--pink-500" />
      <CoffeeLetter letter="O" color="--brand-500" />
      <CoffeeLetter letter="L" color="--mint-300" />
      <CoffeeLetter letter="S" color="--rose-300" />
      <CoffeeLetter letter="A" color="--pink-500" />
      <div class="coffee-cover_message">
        <p>
          De Bolivia
          <br />a tu primera taza.
        </p>
        <img
          src={frameSticker.src}
          alt=""
          aria-hidden="true"
          width="145"
          height="138"
          loading="lazy"
        />
      </div>
    </div>
    <div class="coffee-cover_bottom">
      <span>Buen café. También en casa.</span>
      <button type="button" data-coffee-browse="">
        Desliza y encuentra el tuyo{" "}
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path
            d="M5 16h21M17 6l10 10-10 10"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>
)}
<style is:global>
  @layer components {
    .coffee-cover_wrap {
      --cover-cell: min(
        calc((100vw - 2 * var(--gutter)) / 6),
        calc((min(100svh, 67.5rem) - 11rem) / 3)
      );
      width: 100vw;
      flex: 0 0 100vw;
      min-height: min(48.75rem, 100svh);
      height: 100svh;
      max-height: 67.5rem;
      padding: 4.75rem var(--gutter) 1.625rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .coffee-cover_layout {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: repeat(3, minmax(0, 1fr));
      width: calc(var(--cover-cell) * 6);
      height: calc(var(--cover-cell) * 3);
      flex: 0 0 auto;
      margin-inline: auto;
    }
    .coffee-cover_arrow {
      display: grid;
      place-items: center;
      border: 0.0625rem solid var(--ink);
      margin: 0 -0.0625rem -0.0625rem 0;
      background: var(--yellow);
    }
    .coffee-cover_arrow svg {
      width: 76%;
      height: 76%;
    }
    .coffee-cover_photo {
      position: relative;
      margin: 0;
      overflow: hidden;
      border: 0.0625rem solid var(--ink);
    }
    .coffee-cover_photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .coffee-cover_photo-top {
      grid-column: 6 / 7;
      grid-row: 1;
    }
    .coffee-cover_photo-top::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background: var(--shadow-medium);
    }
    .coffee-cover_photo-top span {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: grid;
      place-items: center;
      color: var(--white);
      font-size: calc(var(--cover-cell) * 0.65);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.065em;
    }
    .coffee-cover_photo-tall {
      grid-column: 1 / 2;
      grid-row: 2 / 4;
    }
    .coffee-cover_photo-tall img {
      object-position: 55% center;
    }
    .coffee-cover_message {
      grid-column: 2 / 7;
      grid-row: 3;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      padding: 1.25rem 0.5rem 1.25rem 2rem;
    }
    .coffee-cover_message p {
      font-size: clamp(1.5625rem, 3.1vw, 3rem);
      font-weight: 650;
      line-height: 1.14;
      letter-spacing: -0.055em;
      max-width: 11em;
    }
    .coffee-cover_message > img {
      width: min(13vw, 9.6875rem);
      height: min(13vw, 9.6875rem);
      object-fit: contain;
      transform: rotate(9deg);
    }
    .coffee-cover_bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      width: calc(var(--cover-cell) * 6);
      max-width: 100%;
      margin-inline: auto;
      padding-top: 1.4375rem;
      font-size: 0.875rem;
    }
    .coffee-cover_bottom button {
      display: flex;
      align-items: center;
      gap: 1.125rem;
      min-height: 2.75rem;
      font-weight: 700;
    }
    .coffee-cover_bottom svg {
      width: 1.5625rem;
      height: 1.5625rem;
    }
    @media (max-width: 56.25rem), (max-height: 38.75rem) {
      .coffee-cover_wrap,
      .coffee-product_wrap {
        scroll-snap-align: start;
      }
    }
    @media (max-width: 56.25rem), (max-height: 38.75rem) {
      .coffee-cover_wrap {
        min-height: 38.125rem;
        height: 86svh;
        padding-top: 5rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-cover_wrap {
        --cover-cell: calc((100vw - 2.5rem) / 5);
        height: auto;
        min-height: 40.625rem;
        padding: 5.625rem 1.25rem 1.75rem;
        justify-content: center;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-cover_layout {
        grid-template-columns: repeat(5, minmax(0, 1fr));
        grid-template-rows: repeat(4, minmax(0, 1fr));
        width: 100%;
        height: calc(var(--cover-cell) * 4);
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-cover_arrow {
        grid-column: 1;
        grid-row: 1;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-cover_photo-top {
        grid-column: 1 / 4;
        grid-row: 2;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-cover_photo-tall {
        grid-column: 4 / 6;
        grid-row: 2;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-cover_message {
        grid-column: 1 / 6;
        grid-row: 4;
        padding: 0.25rem 0;
        gap: 0.75rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-cover_message p {
        font-size: 1.25rem;
        max-width: 9em;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-cover_message > img {
        width: calc(var(--cover-cell) * 0.8);
        height: calc(var(--cover-cell) * 0.8);
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-cover_bottom {
        align-items: end;
        font-size: 0.75rem;
        gap: 0.625rem;
        padding-top: 1.75rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-cover_bottom > span {
        max-width: 8.125rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-cover_bottom button {
        gap: 0.5rem;
        font-size: 0.75rem;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .coffee-cover_wrap,
      .coffee-product_wrap {
        scroll-snap-align: start;
      }
    }
  }
</style>
