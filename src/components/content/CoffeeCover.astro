---
import CoffeeLetter from "@/components/item/CoffeeLetter.astro";
import tostadorImage from "@/assets/images/tostador.avif";
import baristaImage from "@/assets/images/barista.avif";
import frameSticker from "@/assets/stickers/Frame.svg";
import frame1Sticker from "@/assets/stickers/Frame-1.svg";

interface Props {
  render?: boolean;
}
const { render = true } = Astro.props;
---

{render && (
  <div class="coffee-cover_wrap">
    <h2 class="sr-only" id="coffee-scene-title">
      Café en bolsa. De Bolivia a tu casa.
    </h2>
    <div class="coffee-cover_layout">
      <button
        class="coffee-cover_cell coffee-cover_arrow ph-r1c1"
        type="button"
        data-coffee-browse=""
        aria-label="Explorar los cafés"
      >
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path
            d="M5 16h21M17 6l10 10-10 10"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
      <CoffeeLetter letter="C" color="--pink-500" class="ph-r1c2" />
      <CoffeeLetter letter="A" color="--brand-500" class="ph-r1c3" />
      <CoffeeLetter letter="F" color="--mint-300" class="ph-r1c4" />
      <CoffeeLetter letter="É" color="--rose-300" class="ph-r1c5" />
      <figure class="coffee-cover_cell coffee-cover_photo coffee-cover_photo-top ph-r1c67">
        <img
          src={tostadorImage.src}
          alt="El oficio del tueste en Typica"
          width="1500"
          height="1000"
          loading="lazy"
        />
        <span aria-hidden="true">EN</span>
      </figure>
      <figure class="coffee-cover_cell coffee-cover_photo coffee-cover_photo-tall ph-r2c1">
        <img
          src={baristaImage.src}
          alt="Una barista de Typica, del café a la taza"
          width="1500"
          height="1000"
          loading="lazy"
        />
      </figure>
      <CoffeeLetter letter="B" color="--pink-500" class="ph-r2c2" />
      <CoffeeLetter letter="O" color="--brand-500" class="ph-r2c3" />
      <CoffeeLetter letter="L" color="--mint-300" class="ph-r2c4" />
      <CoffeeLetter letter="S" color="--rose-300" class="ph-r2c5" />
      <CoffeeLetter letter="A" color="--pink-500" class="ph-r2c6" />
      <button
        class="coffee-cover_cell ph-cell--letter ph-r2c7 coffee-letter_wrap is-sticker-tile"
        type="button"
        aria-label="Sticker interactivo Typica"
        aria-pressed="false"
        style="--tile-color: var(--pink-500);"
      >
        <span class="coffee-letter_turn" aria-hidden="true">
          <span class="coffee-letter_front coffee-cover_sticker-front">
            <img
              src={frame1Sticker.src}
              alt=""
              width="150"
              height="150"
              loading="lazy"
            />
          </span>
          <span class="coffee-letter_back">
            <img
              src={frameSticker.src}
              alt=""
              width="145"
              height="138"
              loading="lazy"
            />
          </span>
        </span>
      </button>
      <div class="coffee-cover_message">
        <p>
          De Bolivia
          <br />a tu primera taza.
        </p>
        <img
          src={frameSticker.src}
          alt=""
          aria-hidden="true"
          width="145"
          height="138"
          loading="lazy"
        />
      </div>
    </div>
    <div class="coffee-cover_bottom">
      <span>Buen café. También en casa.</span>
      <button type="button" data-coffee-browse="">
        Desliza y encuentra el tuyo{" "}
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path
            d="M5 16h21M17 6l10 10-10 10"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>
)}
<style is:global>
  @layer components {
    .coffee-cover_wrap {
      --cover-cell: min(
        calc((min(100vw, 120rem) - 2 * var(--gutter)) / 7),
        calc((100svh - 10.5rem) / 3)
      );
      width: 100vw;
      flex: 0 0 100vw;
      min-height: min(48.75rem, 100svh);
      height: 100svh;
      max-height: 67.5rem;
      padding: 4.75rem var(--gutter) 1.625rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .coffee-cover_layout {
      display: grid;
      grid-template-columns: repeat(7, var(--cover-cell));
      grid-template-rows: repeat(3, var(--cover-cell));
      width: calc(var(--cover-cell) * 7);
      height: calc(var(--cover-cell) * 3);
      flex: 0 0 auto;
      margin-inline: 0 auto;
    }
    /* Reference border system (products-hero.css) */
    .coffee-cover_cell {
      position: relative;
      border-right: 2px solid var(--ink);
      border-bottom: 2px solid var(--ink);
      overflow: hidden;
      min-width: 0;
      min-height: 0;
      box-sizing: border-box;
    }
    /* Grid positions for desktop */
    .ph-r1c1 { grid-column: 1; grid-row: 1; }
    .ph-r1c2 { grid-column: 2; grid-row: 1; }
    .ph-r1c3 { grid-column: 3; grid-row: 1; }
    .ph-r1c4 { grid-column: 4; grid-row: 1; }
    .ph-r1c5 { grid-column: 5; grid-row: 1; }
    .ph-r1c67 { grid-column: 6 / 8; grid-row: 1; }

    .ph-r2c1 { grid-column: 1; grid-row: 2 / 4; }
    .ph-r2c2 { grid-column: 2; grid-row: 2; }
    .ph-r2c3 { grid-column: 3; grid-row: 2; }
    .ph-r2c4 { grid-column: 4; grid-row: 2; }
    .ph-r2c5 { grid-column: 5; grid-row: 2; }
    .ph-r2c6 { grid-column: 6; grid-row: 2; }
    .ph-r2c7 { grid-column: 7; grid-row: 2; }

    /* Left perimeter border */
    .ph-r1c1,
    .ph-r2c1 {
      border-left: 2px solid var(--ink);
    }
    /* Top perimeter border */
    .ph-r1c1,
    .ph-r1c2,
    .ph-r1c3,
    .ph-r1c4,
    .ph-r1c5,
    .ph-r1c67 {
      border-top: 2px solid var(--ink);
    }
    /* Row 2 collapse: top border with margin-top: -2px */
    .ph-r2c1,
    .ph-r2c2,
    .ph-r2c3,
    .ph-r2c4,
    .ph-r2c5,
    .ph-r2c6,
    .ph-r2c7 {
      border-top: 2px solid var(--ink);
      margin-top: -2px;
    }

    .coffee-cover_arrow {
      height: 100%;
      width: 100%;
      display: grid;
      place-items: center;
      background: var(--yellow);
      cursor: pointer;
    }
    .coffee-cover_arrow svg {
      width: 76%;
      height: 76%;
    }
    .coffee-cover_photo {
      position: relative;
      margin: 0;
      overflow: hidden;
      font-size: var(--text-main);
    }
    .coffee-cover_photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .coffee-cover_photo-top::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background: var(--shadow-medium);
    }
    .coffee-cover_photo-top span {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: grid;
      place-items: center;
      color: var(--white);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.065em;
      font-size: clamp(2rem, 7.5vw, 12rem);
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
    }
    .coffee-cover_photo-tall img {
      object-position: 55% center;
    }
    .is-sticker-tile .coffee-cover_sticker-front {
      background: var(--pink-500);
      display: grid;
      place-items: center;
    }
    .is-sticker-tile .coffee-cover_sticker-front img {
      width: 77%;
      height: 77%;
      object-fit: contain;
    }
    .coffee-cover_message {
      grid-column: 2 / 8;
      grid-row: 3;
      min-height: 0;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding: 0.5rem 0 0 1.5rem;
    }
    .coffee-cover_message p {
      font-size: clamp(1.125rem, 2.3vw, 2.75rem);
      font-weight: 650;
      line-height: 1.14;
      letter-spacing: -0.055em;
      max-width: 11em;
      margin: 0;
    }
    .coffee-cover_message > img {
      height: 80%;
      max-height: 7.5rem;
      width: auto;
      object-fit: contain;
      transform: rotate(9deg);
    }
    .coffee-cover_bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      width: 100%;
      max-width: 100%;
      margin-inline: auto;
      padding-top: 1.4375rem;
      font-size: 0.875rem;
    }
    .coffee-cover_bottom button {
      display: flex;
      align-items: center;
      gap: 1.125rem;
      min-height: 2.75rem;
      font-weight: 700;
      cursor: pointer;
    }
    .coffee-cover_bottom svg {
      width: 1.5625rem;
      height: 1.5625rem;
    }
    @media (max-width: 56.25rem), (max-height: 38.75rem) {
      .coffee-cover_wrap,
      .coffee-product_wrap {
        scroll-snap-align: start;
      }
      .coffee-cover_wrap {
        --cover-cell: min(
          calc((100vw - 2 * var(--gutter)) / 7),
          calc((86svh - 6rem) / 3)
        );
        min-height: 38.125rem;
        height: 86svh;
        padding-top: 5rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-cover_wrap {
        --cover-cell: min(calc((100vw - 2.5rem) / 5), 6.5rem);
        height: auto;
        min-height: 40.625rem;
        padding: 5.625rem 1.25rem 1.75rem;
        justify-content: center;
      }
      .coffee-cover_layout {
        grid-template-columns: repeat(5, var(--cover-cell));
        grid-template-rows: repeat(4, var(--cover-cell));
        width: calc(var(--cover-cell) * 5);
        height: calc(var(--cover-cell) * 4);
        margin-inline: auto;
      }
      .ph-r1c1 { grid-column: 1; grid-row: 1; border-left: 2px solid var(--ink); border-top: 2px solid var(--ink); }
      .ph-r1c2 { grid-column: 2; grid-row: 1; border-top: 2px solid var(--ink); }
      .ph-r1c3 { grid-column: 3; grid-row: 1; border-top: 2px solid var(--ink); }
      .ph-r1c4 { grid-column: 4; grid-row: 1; border-top: 2px solid var(--ink); }
      .ph-r1c5 { grid-column: 5; grid-row: 1; border-top: 2px solid var(--ink); }

      .ph-r1c67 {
        grid-column: 1 / 4;
        grid-row: 2;
        border-left: 2px solid var(--ink);
        border-top: 2px solid var(--ink);
        margin-top: -2px;
      }
      .ph-r2c1 {
        grid-column: 4 / 6;
        grid-row: 2;
        border-left: none;
        border-top: 2px solid var(--ink);
        margin-top: -2px;
      }
      .ph-r2c2 {
        grid-column: 1;
        grid-row: 3;
        border-left: 2px solid var(--ink);
        border-top: 2px solid var(--ink);
        margin-top: -2px;
      }
      .ph-r2c3 { grid-column: 2; grid-row: 3; border-top: 2px solid var(--ink); margin-top: -2px; }
      .ph-r2c4 { grid-column: 3; grid-row: 3; border-top: 2px solid var(--ink); margin-top: -2px; }
      .ph-r2c5 { grid-column: 4; grid-row: 3; border-top: 2px solid var(--ink); margin-top: -2px; }
      .ph-r2c6 { grid-column: 5; grid-row: 3; border-top: 2px solid var(--ink); margin-top: -2px; }
      .ph-r2c7 { display: none; }

      .coffee-cover_message {
        grid-column: 1 / 6;
        grid-row: 4;
        padding: 1.25rem 0 0;
        gap: 0.75rem;
      }
      .coffee-cover_message p {
        font-size: 1.6875rem;
        max-width: 9em;
      }
      .coffee-cover_message > img {
        width: 4.8125rem;
        height: 4.8125rem;
      }
      .coffee-cover_bottom {
        align-items: end;
        font-size: 0.75rem;
        gap: 0.625rem;
        padding-top: 1.75rem;
      }
      .coffee-cover_bottom > span {
        max-width: 8.125rem;
      }
      .coffee-cover_bottom button {
        gap: 0.5rem;
        font-size: 0.75rem;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .coffee-cover_wrap,
      .coffee-product_wrap {
        scroll-snap-align: start;
      }
    }
  }
</style>
