---
import baristaImage from "@/assets/images/barista.avif";
import frame1Sticker from "@/assets/stickers/Frame-1.svg";
import barraImage from "@/assets/images/barra.avif";
import granosImage from "@/assets/images/granos.avif";
import truus39Sticker from "@/assets/stickers/truus.co-39.svg";

interface Props {
  render?: boolean;
}
const { render = true } = Astro.props;
---

{render && (
  <div class="photo-fan_wrap">
    <figure class="photo-fan_photo photo-fan_photo-a">
      <img
        src={baristaImage.src}
        alt="Una barista de Typica preparando una taza"
        width="1500"
        height="1000"
        loading="lazy"
      />
      <img
        class="sticker photo-fan_cups"
        src={frame1Sticker.src}
        alt=""
        aria-hidden="true"
      />
    </figure>
    <figure class="photo-fan_photo photo-fan_photo-b">
      <img
        src={barraImage.src}
        alt="Una taza servida entre plantas y objetos de la casa Typica"
        width="1500"
        height="1125"
        loading="lazy"
      />
    </figure>
    <figure class="photo-fan_photo photo-fan_photo-c">
      <img
        src={granosImage.src}
        alt="Granos de café de Typica recién tostados"
        width="1500"
        height="1500"
        loading="lazy"
      />
      <img
        class="sticker photo-fan_smile"
        src={truus39Sticker.src}
        alt=""
        aria-hidden="true"
      />
    </figure>
  </div>
)}
<style is:global>
  @layer components {
    .photo-fan_wrap {
      position: relative;
      width: 88%;
      max-width: 81.25rem;
      margin: 6.875rem auto 4.6875rem;
      height: 23.125rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      isolation: isolate;
    }
    .photo-fan_photo {
      width: 35%;
      height: 20rem;
      flex-shrink: 0;
      overflow: hidden;
      border-radius: 0.9375rem;
      position: relative;
    }
    .photo-fan_photo > img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .photo-fan_photo-a {
      align-self: flex-start;
      z-index: 1;
    }
    .photo-fan_photo-b {
      align-self: flex-end;
      z-index: 3;
      margin: 0 -3%;
    }
    .photo-fan_photo-c {
      align-self: flex-start;
      z-index: 2;
    }
    .photo-fan_cups {
      width: 7.1875rem;
      bottom: -0.625rem;
      left: -2.5rem;
      transform: rotate(-10deg);
    }
    .photo-fan_smile {
      width: 5.9375rem;
      right: -2.1875rem;
      top: -2.5rem;
      transform: rotate(8deg);
    }
    @media (max-width: 71.875rem) {
      .photo-fan_wrap {
        width: 96%;
        height: 20.625rem;
      }
    }
    @media (max-width: 71.875rem) {
      .photo-fan_photo {
        height: 17.5rem;
      }
    }
    @media (max-width: 56.25rem) {
      .photo-fan_wrap {
        height: 16.875rem;
        margin-top: 5rem;
      }
    }
    @media (max-width: 56.25rem) {
      .photo-fan_photo {
        height: 14.375rem;
      }
    }
    @media (max-width: 56.25rem) {
      .photo-fan_cups {
        width: 5.3125rem;
        left: -0.9375rem;
      }
    }
    @media (max-width: 56.25rem) {
      .photo-fan_smile {
        width: 4.6875rem;
        right: -0.9375rem;
      }
    }
    @media (max-width: 43.75rem) {
      .photo-fan_wrap {
        height: 18.125rem;
        width: 110%;
        margin: 4.375rem -5% 2.8125rem;
      }
    }
    @media (max-width: 43.75rem) {
      .photo-fan_photo {
        height: 14.375rem;
        width: 41%;
        border-radius: 0.75rem;
      }
    }
    @media (max-width: 43.75rem) {
      .photo-fan_photo-a {
        align-self: flex-start;
      }
    }
    @media (max-width: 43.75rem) {
      .photo-fan_photo-b {
        align-self: flex-end;
        margin: 0 -12%;
        z-index: 3;
      }
    }
    @media (max-width: 43.75rem) {
      .photo-fan_photo-c {
        align-self: center;
      }
    }
    @media (max-width: 43.75rem) {
      .photo-fan_cups {
        width: 5rem;
        left: 2%;
        bottom: -0.9375rem;
      }
    }
    @media (max-width: 43.75rem) {
      .photo-fan_smile {
        width: 4.0625rem;
        right: 3%;
        top: -1.25rem;
      }
    }
    @media (max-width: 27.5rem) {
      .photo-fan_wrap {
        height: 15rem;
      }
    }
    @media (max-width: 27.5rem) {
      .photo-fan_photo {
        height: 12.1875rem;
      }
    }
  }
</style>

<script>
  import "@/scripts/intro-fan.js";
</script>
