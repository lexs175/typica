---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow-full.svg";
import close from "@/assets/icons/close.svg";
import play from "@/assets/icons/play.svg";
import pause from "@/assets/icons/pause.svg";
import cartBagIcon from "@/assets/icons/cart-bag.svg";
import { slotContent } from "@/utils/slots.ts";

type Emphasis = "primary" | "secondary";

type Tag =
  | (HTMLAttributes<"button"> & {
      /** Rendered element. */
      element?: "button";
      /** Native button type. */
      type?: "button" | "submit" | "reset";
      /** Disable the button. */
      disabled?: boolean;
      href?: never;
    })
  | (Omit<HTMLAttributes<"a">, "type"> & {
      element: "link";
      /** Link destination. */
      href?: string;
      type?: never;
      disabled?: never;
    });

type Kind =
  | {
      /** Button type. */
      variant?: "main";
      /** Visual emphasis. */
      emphasis?: Emphasis;
      label?: never;
      pressed?: never;
      direction?: never;
      count?: never;
    }
  | {
      variant: "link";
      /** A link carries no weight of its own: it is already the quietest. */
      emphasis?: never;
      label?: never;
      pressed?: never;
      direction?: never;
      count?: never;
    }
  | {
      variant: "play";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Play` or `Pause`. */
      label?: string;
      /** Show the pause icon and pressed state. */
      pressed?: boolean;
      direction?: never;
      count?: never;
    }
  | {
      variant: "close";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Close`. */
      label?: string;
      pressed?: never;
      direction?: never;
      count?: never;
    }
  | {
      variant: "arrow";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Next` or `Previous`. */
      label?: string;
      pressed?: never;
      /** Arrow direction. */
      direction?: "forward" | "back";
      count?: never;
    }
  | {
      variant: "cart";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Abrir carrito`. */
      label?: string;
      /** Count of items in the cart badge. Defaults to 0. */
      count?: number;
      pressed?: never;
      direction?: never;
    };

type Props = {
  /** Set to `false` to omit the component. */
  render?: boolean;
} & Tag &
  Kind;

type AllProps = HTMLAttributes<"button"> &
  Omit<HTMLAttributes<"a">, "type"> & {
    render?: boolean;
    variant?: "main" | "link" | "play" | "close" | "arrow" | "cart";
    emphasis?: Emphasis;
    label?: string;
    count?: number;
    pressed?: boolean;
    direction?: "forward" | "back";
    element?: "button" | "link";
    href?: string;
    type?: "button" | "submit" | "reset";
  };

const {
  render = true,
  variant = "main",
  emphasis = "primary",
  label,
  count = 0,
  pressed = false,
  direction = "forward",
  element = "button",
  href,
  type = "button",
  class: className,
  ...rest
} = Astro.props as AllProps;

const isLink = element === "link";
const Tag = isLink ? "a" : "button";
const tagAttrs = isLink
  ? { href: href || "#" }
  : { type: type === "submit" ? undefined : type };

const marks = { play, close, arrow };
/* main, link, and cart are written, the rest are marks with a label. */
const isWritten =
  variant === "main" || variant === "link" || variant === "cart";
const rawContent = isWritten ? await slotContent(Astro.slots) : "";
const content = rawContent || (variant === "cart" ? "Carrito" : "");

const named = {
  play: pressed ? "Pause" : "Play",
  close: "Close",
  arrow: direction === "back" ? "Previous" : "Next",
  cart: `Abrir carrito, ${count} ${count === 1 ? "bolsa" : "bolsas"}`,
};

const ariaLabelProp = rest["aria-label"];
delete rest["aria-label"];
const resolvedAriaLabel =
  ariaLabelProp ??
  label ??
  (variant === "cart"
    ? named.cart
    : isWritten
      ? undefined
      : named[variant]);
---

{render && (isWritten ? content : true) && (
  <Tag
    class:list={[
      "button_wrap",
      emphasis !== "primary" && emphasis,
      variant !== "main" && variant,
      variant === "arrow" && direction === "back" && "back",
      className,
    ]}
    aria-label={resolvedAriaLabel}
    aria-pressed={variant === "play" ? pressed : undefined}
    {...tagAttrs}
    {...rest}
  >
    {variant === "cart" && (
      <div
        class="site-header_cart-badge-wrap button_cart-badge-wrap"
        aria-hidden="true"
      >
        <img
          src={cartBagIcon.src}
          alt=""
          width="22"
          height="25"
          class="site-header_cart-bag button_cart-bag"
        />
        <span class="site-header_count button_cart-count">
          {count}
        </span>
      </div>
    )}
    {variant === "main" && (
      <Icon class="button_mark" src={arrow} variant="medium" />
    )}
    {isWritten && (
      <span class="button_text text-style-trim">
        <Fragment set:html={content} />
      </span>
    )}
    {variant === "play" && (
      <Fragment>
        <Icon class="button_mark button_play" src={play} variant="small" />
        <Icon class="button_mark button_pause" src={pause} variant="small" />
      </Fragment>
    )}
    {variant === "close" && (
      <Icon class="button_mark" src={marks.close} variant="small" />
    )}
    {variant === "arrow" && (
      <Icon class="button_mark" src={marks.arrow} variant="small" />
    )}
  </Tag>
)}

<style is:global>
  @layer components {
    .button_wrap {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 0.5em;
      padding: 0.75em 1.5em;
      background-color: var(--button-background);
      color: var(--button-text);
      border: var(--border-width) solid var(--button-border);
      border-radius: 0.5em;
      line-height: 1.2;
      text-decoration: none;
      text-align: center;
      & .button_mark {
        --border-width: var(--button-icon-stroke);
      }
      transition:
        transform var(--button-press-duration) var(--button-press-ease),
        box-shadow var(--button-press-duration) var(--button-press-ease);
      &:not(.link, .play, .close, .arrow) {
        gap: var(--button-gap);
        padding: 0.85em 1.5em;
        min-height: 3.5rem;
        border: var(--button-stroke) solid var(--button-shadow-color);
        border-radius: var(--button-radius);
        box-shadow: calc(var(--button-shadow-size) * -1)
          var(--button-shadow-size) 0 var(--button-shadow-color);
        font-weight: var(--button-font-weight);
        cursor: pointer;
        @media (hover: hover) {
          &:hover:not(:disabled) {
            transform: translate(
              calc(var(--button-shadow-size) * -1),
              var(--button-shadow-size)
            );
            box-shadow: 0 0 0 transparent;
          }
        }
        &:active:not(:disabled) {
          transform: translate(
            calc(var(--button-shadow-size) * -1),
            var(--button-shadow-size)
          );
          box-shadow: 0 0 0 transparent;
        }
      }
      @media (hover: hover) {
        &:hover:not(:disabled):is(.link, .play, .close, .arrow) {
          background-color: var(--button-background-hover);
          color: var(--button-text-hover);
          border-color: var(--button-border-hover);
        }
      }
      &.cart {
        --button-background: #ffe239;
        --button-text: #000000;
        --button-stroke: 1.5px;
        --button-border: #000000;
        --button-shadow-size: 4px;
        --button-shadow-color: #ffffff;
        --button-radius: 6px;
        --button-press-duration: 160ms;
        --button-press-ease: cubic-bezier(0.2, 0.8, 0.2, 1);

        background-color: var(--button-background);
        color: var(--button-text);
        border: var(--button-stroke) solid var(--button-border);
        border-radius: var(--button-radius);
        box-shadow: calc(var(--button-shadow-size) * -1)
          var(--button-shadow-size) 0 var(--button-shadow-color);
        padding: 8px 14px;
        min-height: unset;
        gap: 14px;
        cursor: pointer;
        user-select: none;
        white-space: nowrap;

        & .button_text {
          font-family: var(--font-headline);
          font-size: clamp(19px, 1.25vw, 23.5px);
          font-weight: 900;
          line-height: 1;
          color: #000000;
          letter-spacing: -0.02em;
          margin-top: 1px;
        }

        & .button_cart-badge-wrap {
          position: relative;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: 22px;
          height: 25px;
          flex-shrink: 0;
        }

        & .button_cart-bag {
          width: 22px;
          height: 25px;
          display: block;
        }

        & .button_cart-count {
          position: absolute;
          top: -2px;
          right: -7px;
          min-width: 18px;
          height: 18px;
          padding: 0 4px;
          background-color: #000000;
          color: #ffffff;
          border-radius: 999px;
          display: grid;
          place-items: center;
          font-family: var(--font-headline);
          font-size: 11px;
          font-weight: 700;
          line-height: 1;
          box-sizing: border-box;
        }

        @media (max-width: 480px) {
          padding: 8px 10px;
          gap: 0;
          & .button_text {
            display: none;
          }
        }
      }
      &.secondary {
        --button-background: var(--button-2-background);
        --button-text: var(--button-2-text);
        --button-border: var(--button-2-border);
        --button-background-hover: var(--button-2-background-hover);
        --button-text-hover: var(--button-2-text-hover);
        --button-border-hover: var(--button-2-border-hover);
      }
      &.link {
        --button-background: transparent;
        --button-text: var(--link-text);
        --button-border: var(--link-border);
        --button-background-hover: transparent;
        --button-text-hover: var(--link-text-hover);
        --button-border-hover: var(--link-border);

        padding: 0.4em 0;
        border: 0;
        border-bottom: var(--border-width) solid var(--button-border);
        border-radius: 0;
        background-image: linear-gradient(
          var(--link-border-hover),
          var(--link-border-hover)
        );
        background-repeat: no-repeat;
        background-origin: border-box;
        background-position: 100% 100%;
        background-size: 0 var(--border-width);
        transition:
          background-size calc(var(--hover-duration) * 2) var(--hover-ease),
          color var(--hover-duration) var(--hover-ease),
          border-color var(--hover-duration) var(--hover-ease);
        @media (hover: hover) {
          &:hover:not(:disabled) {
            background-position: 0 100%;
            background-size: 100% var(--border-width);
          }
        }
      }
      &:is(.play, .close, .arrow) {
        gap: 0;
        padding: 0.75em;
        border-radius: var(--radius-round);
      }
      &.back .button_mark {
        rotate: 180deg;
      }
      &.play .button_pause {
        display: none;
      }
      &.play[aria-pressed="true"] {
        & .button_play {
          display: none;
        }
        & .button_pause {
          display: block;
        }
      }
      &:disabled {
        cursor: not-allowed;
        opacity: 0.5;
      }
      @media (prefers-reduced-motion: reduce) {
        transition: none;
      }
    }
  }
</style>
