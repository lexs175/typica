---
interface Props {
  text?: string;
  variant?: "red" | "black";
  tilt?: boolean | number | string;
  class?: string;
  ariaLabel?: string;
}

const {
  text = "SE DISFRUTA",
  variant = "red",
  tilt = false,
  class: className = "",
  ariaLabel,
  ...rest
} = Astro.props;

const label = ariaLabel || text;
const tiltStyle =
  typeof tilt === "number"
    ? `transform: rotate(${tilt}deg);`
    : typeof tilt === "string"
      ? `transform: rotate(${tilt});`
      : undefined;
---

{/* Cartel / Placa: contenedor exterior con borde 4px, border-radius 16px, y gap 10px */}
<div
  class:list={[
    "cartel-plaque",
    `cartel-plaque--${variant}`,
    { "cartel-plaque--tilted": tilt === true },
    className,
  ]}
  style={tiltStyle}
  role="img"
  aria-label={label}
  {...rest}
>
  {/* Div 1: Columna izquierda con 2 círculos vectoriales perfectos */}
  <div class="cartel-col cartel-col--left" aria-hidden="true">
    <svg class="cartel-dot" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <circle cx="8" cy="8" r="8" fill="currentColor" />
    </svg>
    <svg class="cartel-dot" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <circle cx="8" cy="8" r="8" fill="currentColor" />
    </svg>
  </div>

  {/* Div 2: Centro con el texto */}
  <div class="cartel-center">
    <slot>{text}</slot>
  </div>

  {/* Div 3: Columna derecha con 2 círculos vectoriales perfectos */}
  <div class="cartel-col cartel-col--right" aria-hidden="true">
    <svg class="cartel-dot" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <circle cx="8" cy="8" r="8" fill="currentColor" />
    </svg>
    <svg class="cartel-dot" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <circle cx="8" cy="8" r="8" fill="currentColor" />
    </svg>
  </div>
</div>

<style>
  /* =========================================================
     CARTEL / PLACA TYPICA (FIGMA FRAME 86)
     Arquitectura proporcional con EM: 
     Una sola variable font-size fluida escala bordes, radios,
     remaches y padding en perfecta armonía matemática.
     ========================================================= */
  .cartel-plaque {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-headline);
    font-weight: 900;
    font-size: clamp(1.8rem, 4.6vw, 5.5rem);
    gap: 0.16em;
    border-radius: 0.28em;
    border: 0.07em solid #000000;
    box-sizing: border-box;
    box-shadow: none !important;
    user-select: none;
    max-width: 100%;
    transform-origin: center center;
  }

  /* Variante Roja */
  .cartel-plaque--red {
    background-color: #FF0000;
    border-color: #000000;
    color: #000000;
  }

  /* Variante Negra */
  .cartel-plaque--black {
    background-color: #000000;
    border-color: #FFFFFF;
    color: #FFFFFF;
  }

  /* Inclinación para sección de cintas */
  .cartel-plaque--tilted {
    transform: rotate(-3deg);
  }

  /* Columnas laterales de remaches */
  .cartel-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    align-self: stretch;
    padding: 0.22em 0.22em;
    box-sizing: border-box;
    flex-shrink: 0;
  }

  /* Remaches/perforaciones vectoriales exactos (círculos perfectos) */
  .cartel-dot {
    width: 0.18em;
    height: 0.18em;
    display: block;
    flex-shrink: 0;
  }

  /* Centro de texto */
  .cartel-center {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1em;
    line-height: 0.95;
    color: currentColor;
    text-transform: uppercase;
    text-shadow: none !important;
    white-space: nowrap;
    padding-block: 0.12em;
    box-sizing: border-box;
    /* Compensación óptica exacta para centrado vertical 1:1 */
    transform: translateY(0.10em);
  }
</style>
