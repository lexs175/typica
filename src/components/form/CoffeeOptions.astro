---
import QuantityStepper from "@/components/form/QuantityStepper.astro";
import { money, type Coffee } from "@/data/coffees";
interface Props {
  render?: boolean;
  coffee: Coffee;
}
const { render = true, coffee } = Astro.props;
---

{render && (
  <div class="coffee-options_wrap" id={`coffee-options-${coffee.id}`} hidden>
    <p class="coffee-options_description">{coffee.description}</p>
    <form
      class="coffee-options_order-form"
      data-coffee-order={`${coffee.id}`}
      aria-label={"Elegir " + coffee.name + ""}
    >
      <div class="coffee-options_option-row">
        <label for={`weight-${coffee.id}`}>Peso</label>
        <select id={`weight-${coffee.id}`} name="weight">
          <option value="250">250 g</option>
        </select>
      </div>
      <div class="coffee-options_option-row">
        <label for={`grind-${coffee.id}`}>Molienda</label>
        <select id={`grind-${coffee.id}`} name="grind">
          <option>En grano</option>
          <option>Molido para filtro</option>
          <option>Molido para espresso</option>
          <option>Molido para prensa</option>
        </select>
      </div>
      <div class="coffee-options_option-row">
        <span id={`quantity-label-${coffee.id}`}>Cantidad</span>
        <QuantityStepper coffee={coffee} />
      </div>
      <button class="coffee-options_add" type="submit">
        <span>Añadir al carrito</span>
        <output class="coffee-options_total">{money(coffee.price)}</output>
      </button>
      <p class="coffee-options_note">250 g · Precio de muestra</p>
      <p
        class="sr-only coffee-options_status"
        role="status"
        aria-live="polite"
      ></p>
    </form>
  </div>
)}
<style is:global>
  @layer components {
    .coffee-options_wrap {
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
      justify-content: end;
      padding-top: 1.75rem;
    }
    .coffee-options_description {
      font-size: 0.9375rem;
      line-height: 1.65;
      margin-bottom: 1.5rem;
      max-width: 47em;
    }
    .coffee-options_option-row {
      display: grid;
      grid-template-columns: 40% minmax(0, 1fr);
      align-items: stretch;
      min-height: 3.375rem;
      border-top: 0.0625rem solid var(--border-muted);
    }
    .coffee-options_option-row > label,
    .coffee-options_option-row > span {
      display: flex;
      align-items: center;
      font-size: 0.875rem;
      font-weight: 600;
      padding: 0.625rem 0.75rem 0.625rem 0;
    }
    .coffee-options_option-row > select {
      width: 100%;
      min-width: 0;
      border: 0;
      border-left: 0.0625rem solid var(--border-subtle);
      border-radius: 0;
      background: transparent;
      padding: 0.625rem 0.75rem;
      color: inherit;
      font-size: 0.875rem;
      font-weight: 550;
    }
    .coffee-options_option-row > select option {
      background: var(--light-100);
      color: var(--neutral-900);
    }
    .coffee-options_add {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
      width: 100%;
      min-height: 3.5rem;
      margin-top: 1.5rem;
      padding: 1rem 1.25rem;
      background: var(--light-100);
      color: var(--neutral-900);
      font-size: 0.9375rem;
      font-weight: 550;
    }
    .coffee-options_total {
      font-weight: 750;
      white-space: nowrap;
    }
    .coffee-options_note {
      text-align: center;
      font-size: 0.6875rem;
      line-height: 1.6;
      margin-top: 0.8125rem;
    }
    @media (max-width: 56.25rem), (max-height: 38.75rem) {
      .coffee-options_description {
        font-size: 0.875rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-options_description {
        font-size: 0.8125rem;
        line-height: 1.55;
        margin-bottom: 1.125rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-options_wrap {
        padding-top: 1.5rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-options_option-row {
        min-height: 3.125rem;
        grid-template-columns: 32% minmax(0, 1fr);
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-options_option-row > label,
      .coffee-options_option-row > span {
        font-size: 0.75rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-options_option-row > select {
        font-size: 1rem;
        padding-left: 0.625rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-options_add {
        font-size: 0.875rem;
        margin-top: 1.25rem;
        padding-inline: 1rem;
      }
    }
  }
</style>
