---
import frame1Sticker from "@/assets/stickers/Frame-1.svg";

interface Props {
  render?: boolean;
  letter: string;
  color?: string;
  class?: string;
  sticker?: typeof frame1Sticker;
}
const { render = true, letter, color = "--brand-500", class: className = "", sticker = frame1Sticker } = Astro.props;
---

{render && (
  <button
    class:list={["coffee-cover_cell", "ph-cell--letter", "coffee-letter_wrap", className]}
    type="button"
    aria-label={"Girar la letra " + letter}
    aria-pressed="false"
    style={"--tile-color: var(" + color + ");"}
  >
    <span class="coffee-letter_turn" aria-hidden="true">
      <span class="coffee-letter_front">{letter}</span>
      <span class="coffee-letter_back">
          <img
            src={sticker.src}
            alt=""
            width="150"
            height="150"
            loading="lazy"
          />
      </span>
    </span>
  </button>
)}

<style is:global>
  @layer components {
    .coffee-letter_wrap,
    .coffee-cover_arrow {
      position: relative;
      min-width: 0;
      min-height: 0;
      perspective: 56.25rem;
      outline-offset: -0.375rem !important;
      box-shadow: none !important;
    }
    .coffee-letter_wrap {
      width: 100%;
      height: 100%;
      box-sizing: border-box;
      border-radius: clamp(4px, 0.5vw, 8px);
      overflow: hidden;
      border: none;
      padding: 0;
      cursor: pointer;
    }
    .coffee-letter_turn {
      position: absolute;
      inset: 0;
      transform-style: preserve-3d;
      transition: transform 600ms cubic-bezier(0.77, 0, 0.175, 1);
    }
    .coffee-letter_front,
    .coffee-letter_back {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      border-radius: clamp(4px, 0.5vw, 8px);
    }
    /* Letras frontales: Negro carbón con texto blanco exacto de Figma */
    .coffee-letter_front {
      background: #000000;
      color: #ffffff;
      font-family: var(--font-headline);
      font-weight: 900;
      font-size: calc(var(--cover-cell, 150px) * 0.72);
      line-height: 1;
      letter-spacing: -0.08em;
      padding-right: 0.08em;
      padding-top: 0.06em;
    }
    .coffee-letter_back {
      transform: rotateY(180deg);
      background: var(--tile-color, var(--yellow));
      overflow: hidden;
    }
    .coffee-letter_back img {
      width: 77%;
      height: 77%;
      object-fit: contain;
    }
    /* 3D Flip al hacer hover */
    .coffee-letter_wrap.is-turned .coffee-letter_turn,
    .coffee-letter_wrap:focus-visible .coffee-letter_turn {
      transform: rotateY(180deg);
    }
    @media (hover: hover) and (pointer: fine) {
      .coffee-letter_wrap:hover .coffee-letter_turn {
        transform: rotateY(180deg);
      }
    }
    @media (max-width: 1023px) {
      .coffee-letter_front {
        font-size: clamp(2rem, 9vw, 5.5rem);
      }
    }
  }
</style>
