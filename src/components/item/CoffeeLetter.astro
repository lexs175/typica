---
import frame1Sticker from "@/assets/stickers/Frame-1.svg";

interface Props {
  render?: boolean;
  letter: string;
  color: string;
}
const { render = true, letter, color } = Astro.props;
---

{render && (
  <button
    class="coffee-letter_wrap"
    type="button"
    aria-label={"Girar la letra " + letter}
    aria-pressed="false"
    style={"--tile-color: var(" + color + ");"}
  >
    <span class="coffee-letter_turn" aria-hidden="true">
      <span class="coffee-letter_front">{letter}</span>
      <span class="coffee-letter_back">
        <img
          src={frame1Sticker.src}
          alt=""
          width="150"
          height="150"
          loading="lazy"
        />
      </span>
    </span>
  </button>
)}
<style is:global>
  @layer components {
    .coffee-letter_wrap,
    .coffee-cover_arrow {
      position: relative;
      min-width: 0;
      min-height: 0;
      perspective: 56.25rem;
      outline-offset: -0.375rem !important;
    }
    .coffee-letter_wrap {
      border: 0.0625rem solid var(--ink);
      margin: 0 -0.0625rem -0.0625rem 0;
    }
    .coffee-letter_turn {
      position: absolute;
      inset: 0;
      transform-style: preserve-3d;
      transition: transform 600ms cubic-bezier(0.77, 0, 0.175, 1);
    }
    .coffee-letter_front,
    .coffee-letter_back {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
    .coffee-letter_front {
      background: var(--light-300);
      font-weight: 900;
      font-size: calc(var(--cover-cell) * 0.8);
      line-height: 1.1;
      letter-spacing: -0.06em;
      padding: 0.04em 0.03em 0 0;
    }
    .coffee-letter_back {
      transform: rotateY(180deg);
      background: var(--tile-color, var(--yellow));
      overflow: hidden;
    }
    .coffee-letter_back img {
      width: 77%;
      height: 77%;
      object-fit: contain;
    }
    .coffee-letter_wrap.is-turned .coffee-letter_turn,
    .coffee-letter_wrap:focus-visible .coffee-letter_turn {
      transform: rotateY(180deg);
    }
    @media (hover: hover) and (pointer: fine) {
      .coffee-letter_wrap:hover .coffee-letter_turn {
        transform: rotateY(180deg);
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-letter_wrap:nth-of-type(n + 6) {
        grid-row: 3;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .coffee-letter_turn,
      .coffee-product_visual > img,
      .coffee-product_quick-add {
        transition: none;
      }
    }
  }
</style>
