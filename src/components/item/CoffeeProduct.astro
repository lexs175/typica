---
import CoffeeOptions from "@/components/form/CoffeeOptions.astro";
import { money, type Coffee } from "@/data/coffees";
interface Props {
  render?: boolean;
  coffee: Coffee;
}
const { render = true, coffee } = Astro.props;
---

{render && (
  <article
    class:list={["coffee-product_wrap", coffee.theme]}
    data-coffee={`${coffee.id}`}
    aria-labelledby={`product-${coffee.id}`}
  >
    <div class="coffee-product_head">
      <p class="coffee-product_notes">{coffee.notes}</p>
      <h3 id={`product-${coffee.id}`}>{coffee.name}</h3>
      <p class="coffee-product_origin">{coffee.origin}</p>
      <button
        class="coffee-product_quick-add"
        type="button"
        data-coffee-toggle={`${coffee.id}`}
        aria-label={"Ver detalles de " + coffee.name + ""}
        aria-expanded="false"
        aria-controls={`coffee-options-${coffee.id}`}
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M5 12h14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          ></path>
          <path
            class="coffee-product_toggle-vertical"
            d="M12 5v14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
    <button
      class="coffee-product_visual"
      type="button"
      aria-expanded="false"
      aria-controls={`coffee-options-${coffee.id}`}
      data-open-coffee={`${coffee.id}`}
      aria-label={"Conocer " + coffee.name + " y elegir molienda"}
    >
      <img
        src={typeof coffee.image === "string" ? coffee.image : coffee.image.src}
        alt={coffee.alt}
        width="500"
        height="500"
        loading="lazy"
      />
    </button>
    <span class="coffee-product_watermark" aria-hidden="true">
      {coffee.watermark}
    </span>
    <div class="coffee-product_foot">
      <p class="coffee-product_price">
        {money(coffee.price)}
        <span>250 g · En grano</span>
      </p>
    </div>
    <CoffeeOptions coffee={coffee} />
  </article>
)}
<style is:global>
  @layer components {
    .coffee-product_wrap {
      position: relative;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      flex: 0 0 50vw;
      width: 50vw;
      height: 100svh;
      min-height: min(48.75rem, 100svh);
      max-height: 67.5rem;
      padding: 6.5625rem 3.1vw 1.875rem;
      overflow: hidden;
      color: var(--product-ink, var(--neutral-900));
      background: var(--product-ground);
    }
    .coffee-product_wrap + .coffee-product_wrap {
      border-left: 0.0625rem solid var(--shadow-soft);
    }
    /* Tablet (768px - 1023px): 2 columnas, escala tipográfica uniforme */
    @media (max-width: 1023px) {
      .coffee-product_wrap {
        flex: none !important;
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
        height: auto !important;
        min-height: clamp(480px, 50vw, 580px);
        max-height: none !important;
        padding: 2rem 1.5rem 1.75rem;
      }
      .coffee-product_wrap + .coffee-product_wrap {
        border-left: none;
      }
      .coffee-product_head {
        min-height: 114px;
        padding-right: 3.25rem;
      }
      .coffee-product_notes {
        font-size: 0.85rem;
        min-height: 2.7em;
      }
      .coffee-product_wrap h3 {
        font-size: clamp(1.85rem, 2.7vw, 2.45rem);
        line-height: 1.05;
      }
      .coffee-product_origin {
        font-size: 0.85rem;
      }
      .coffee-product_visual {
        min-height: 220px;
        padding: 1.25rem 0;
      }
      .coffee-product_visual > img {
        max-height: clamp(200px, 24vw, 290px);
        max-width: 80%;
      }
      .coffee-product_price {
        font-size: 1.45rem;
        font-weight: 700;
      }
    }
    /* Mobile (< 768px): 1 columna completa, escala brutalista legible */
    @media (max-width: 767px) {
      .coffee-product_wrap {
        flex: none !important;
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
        min-height: auto !important;
        height: auto !important;
        padding: 2.25rem 1.5rem 2rem !important;
      }
      .coffee-product_head {
        min-height: auto;
        padding-right: 3.5rem;
      }
      .coffee-product_notes {
        font-size: 0.9rem;
        min-height: auto;
        margin-bottom: 0.35rem;
      }
      .coffee-product_wrap h3 {
        font-size: clamp(2.35rem, 8.5vw, 3.2rem);
        line-height: 1.02;
      }
      .coffee-product_origin {
        font-size: 0.88rem;
      }
      .coffee-product_visual {
        min-height: 250px;
        padding: 1.5rem 0;
      }
      .coffee-product_visual > img {
        max-height: clamp(240px, 58vw, 320px);
        max-width: 82%;
      }
      .coffee-product_price {
        font-size: 1.6rem;
      }
      .coffee-product_watermark {
        font-size: clamp(4.5rem, 22vw, 7.5rem) !important;
        bottom: 5.5rem !important;
      }
    }
    .coffee-product_gesha {
      --product-ground: #ffe239;
      --product-ink: #000000;
    }
    .coffee-product_java {
      --product-ground: #ff0000;
      --product-ink: #ffffff;
    }
    .coffee-product_blend {
      --product-ground: #3752ff;
      --product-ink: #ffffff;
    }
    .coffee-product_ipr {
      --product-ground: #ff659a;
      --product-ink: #ffffff;
    }
    .coffee-product_head {
      position: relative;
      padding-right: 3.5rem;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      min-height: 124px;
    }
    .coffee-product_notes {
      font-size: var(--text-caption);
      line-height: 1.35;
      font-weight: 500;
      margin: 0 0 0.45rem 0;
      min-height: 2.7em;
      display: flex;
      align-items: flex-end;
      text-wrap: balance;
      opacity: 0.9;
    }
    .coffee-product_wrap h3 {
      font-size: var(--text-h2);
      line-height: var(--line-height-small);
      margin: 0 0 0.35rem 0;
      text-transform: none;
    }
    .coffee-product_origin {
      font-size: var(--text-caption);
      line-height: 1.3;
      font-weight: 500;
      margin: 0;
      opacity: 0.85;
    }
    .coffee-product_quick-add {
      position: absolute;
      top: 0;
      right: 0;
      width: 3.125rem;
      height: 3.125rem;
      display: grid;
      place-items: center;
      color: var(--ink);
      background: var(--white);
      border-radius: 50%;
      transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    .coffee-product_quick-add svg {
      width: 1.4375rem;
      height: 1.4375rem;
    }
    .coffee-product_quick-add:active {
      transform: scale(0.93);
    }
    .coffee-product_quick-add .coffee-product_toggle-vertical {
      opacity: 1;
      transition: opacity 160ms ease;
    }
    .coffee-product_wrap.is-open
      .coffee-product_quick-add
      .coffee-product_toggle-vertical {
      opacity: 0;
    }
    .coffee-product_wrap [hidden] {
      display: none !important;
    }
    .coffee-product_visual {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 1 1 auto;
      min-height: 0;
      width: 100%;
      padding: 1.5rem 0 1rem;
      background: none;
      border: none;
      cursor: pointer;
    }
    .coffee-product_visual > img {
      width: auto;
      height: auto;
      max-width: 82%;
      max-height: clamp(230px, 28vw, 360px);
      object-fit: contain;
      transform: rotate(-6deg);
      transition: transform 450ms cubic-bezier(0.23, 1, 0.32, 1);
      display: block;
      margin: 0 auto;
    }
    .coffee-product_watermark {
      position: absolute;
      inset: auto -0.625rem 6.4375rem;
      overflow: hidden;
      white-space: nowrap;
      z-index: -1;
      font-size: 13.5vw;
      line-height: 1;
      font-weight: 900;
      letter-spacing: -0.08em;
      opacity: 0.09;
      pointer-events: none;
    }
    .coffee-product_foot {
      display: flex;
      align-items: flex-end;
      justify-content: flex-start;
      gap: 1rem;
      margin-top: auto;
      z-index: 2;
      padding-top: 0.5rem;
    }
    .coffee-product_price {
      display: flex;
      flex-direction: column;
      gap: 0.1875rem;
      font-size: var(--text-h3);
      line-height: 1;
    }
    .coffee-product_price span {
      font-size: var(--text-caption);
      font-weight: 500;
      opacity: 0.85;
    }
    @media (hover: hover) and (pointer: fine) {
      .coffee-product_visual:hover > img {
        transform: rotate(0deg) translateY(-0.375rem);
      }
    }
    @media (hover: hover) and (pointer: fine) {
      .coffee-product_quick-add:hover {
        transform: scale(1.06);
      }
    }
    .coffee-product_quick-add [hidden] {
      display: none;
    }
    .coffee-product_blend .coffee-options_option-row {
      border-color: var(--border-inverse);
    }
  }
</style>
