---
import CoffeeOptions from "@/components/form/CoffeeOptions.astro";
import { money, type Coffee } from "@/data/coffees";
interface Props {
  render?: boolean;
  coffee: Coffee;
}
const { render = true, coffee } = Astro.props;
---

{render && (
  <article
    class:list={["coffee-product_wrap", coffee.theme]}
    data-coffee={`${coffee.id}`}
    aria-labelledby={`product-${coffee.id}`}
  >
    <div class="coffee-product_head">
      <p class="coffee-product_notes">{coffee.notes}</p>
      <h3 id={`product-${coffee.id}`}>{coffee.name}</h3>
      <p class="coffee-product_origin">{coffee.origin}</p>
      <button
        class="coffee-product_quick-add"
        type="button"
        data-coffee-toggle={`${coffee.id}`}
        aria-label={"Ver detalles de " + coffee.name + ""}
        aria-expanded="false"
        aria-controls={`coffee-options-${coffee.id}`}
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M5 12h14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          ></path>
          <path
            class="coffee-product_toggle-vertical"
            d="M12 5v14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
    <button
      class="coffee-product_visual"
      type="button"
      aria-expanded="false"
      aria-controls={`coffee-options-${coffee.id}`}
      data-open-coffee={`${coffee.id}`}
      aria-label={"Conocer " + coffee.name + " y elegir molienda"}
    >
      <img
        src={typeof coffee.image === "string" ? coffee.image : coffee.image.src}
        alt={coffee.alt}
        width="500"
        height="500"
        loading="lazy"
      />
    </button>
    <span class="coffee-product_watermark" aria-hidden="true">
      {coffee.watermark}
    </span>
    <div class="coffee-product_foot">
      <p class="coffee-product_price">
        {money(coffee.price)}
        <span>250 g · En grano</span>
      </p>
      <button
        class="coffee-product_details"
        type="button"
        aria-expanded="false"
        aria-controls={`coffee-options-${coffee.id}`}
        data-open-coffee={`${coffee.id}`}
      >
        Elegir molienda{" "}
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path
            d="M5 16h21M17 6l10 10-10 10"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
    </div>
    <p class="coffee-product_sample-note">Precio de muestra</p>
    <CoffeeOptions coffee={coffee} />
  </article>
)}
<style is:global>
  @layer components {
    .coffee-product_wrap {
      position: relative;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      flex: 0 0 50vw;
      width: 50vw;
      height: 100svh;
      min-height: min(48.75rem, 100svh);
      max-height: 67.5rem;
      padding: 6.5625rem 3.1vw 1.875rem;
      overflow: hidden;
      color: var(--product-ink, var(--neutral-900));
      background: var(--product-ground);
    }
    .coffee-product_wrap + .coffee-product_wrap {
      border-left: 0.0625rem solid var(--shadow-soft);
    }
    .coffee-product_gesha {
      --product-ground: var(--rose-300);
    }
    .coffee-product_head {
      position: relative;
      padding-right: 3.875rem;
    }
    .coffee-product_notes {
      font-size: 0.875rem;
      line-height: 1.5;
      margin-bottom: 0.9375rem;
    }
    .coffee-product_wrap h3 {
      font-size: clamp(2.25rem, 4.3vw, 4.5rem);
      font-weight: 800;
      line-height: 1;
      letter-spacing: -0.06em;
    }
    .coffee-product_origin {
      font-size: 0.875rem;
      line-height: 1.45;
      margin-top: 0.75rem;
    }
    .coffee-product_quick-add {
      position: absolute;
      top: 0;
      right: 0;
      width: 3.125rem;
      height: 3.125rem;
      display: grid;
      place-items: center;
      color: var(--ink);
      background: var(--white);
      border-radius: 50%;
      transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    .coffee-product_quick-add svg {
      width: 1.4375rem;
      height: 1.4375rem;
    }
    .coffee-product_quick-add:active {
      transform: scale(0.93);
    }
    .coffee-product_quick-add .coffee-product_toggle-vertical {
      opacity: 1;
      transition: opacity 160ms ease;
    }
    .coffee-product_wrap.is-open
      .coffee-product_quick-add
      .coffee-product_toggle-vertical {
      opacity: 0;
    }
    .coffee-product_wrap [hidden] {
      display: none !important;
    }
    .coffee-product_visual {
      position: relative;
      display: grid;
      place-items: center;
      flex: 1 1 auto;
      min-height: 0;
      width: 100%;
      padding: 1.25rem 0 0.625rem;
    }
    .coffee-product_visual > img {
      width: 100%;
      height: 100%;
      max-height: 30rem;
      object-fit: contain;
      transform: rotate(-7deg);
      transition: transform 450ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    .coffee-product_watermark {
      position: absolute;
      inset: auto -0.625rem 6.4375rem;
      overflow: hidden;
      white-space: nowrap;
      z-index: -1;
      font-size: 13.5vw;
      line-height: 1;
      font-weight: 900;
      letter-spacing: -0.08em;
      opacity: 0.09;
      pointer-events: none;
    }
    .coffee-product_foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
    }
    .coffee-product_price {
      display: flex;
      flex-direction: column;
      gap: 0.1875rem;
      font-size: 1.25rem;
      font-weight: 700;
    }
    .coffee-product_price span {
      font-size: 0.8125rem;
      font-weight: 450;
    }
    .coffee-product_details {
      min-height: 3rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      font-size: 0.875rem;
      font-weight: 650;
      text-decoration: underline;
      text-underline-offset: 0.3125rem;
    }
    .coffee-product_details svg {
      width: 1.4375rem;
      height: 1.4375rem;
    }
    .coffee-product_sample-note {
      position: absolute;
      bottom: 0.5rem;
      right: 3.1vw;
      font-size: 0.625rem;
      opacity: 0.7;
    }
    @media (hover: hover) and (pointer: fine) {
      .coffee-product_visual:hover > img {
        transform: rotate(0deg) translateY(-0.375rem);
      }
    }
    @media (hover: hover) and (pointer: fine) {
      .coffee-product_quick-add:hover {
        transform: scale(1.06);
      }
    }
    @media (max-width: 56.25rem), (max-height: 38.75rem) {
      .coffee-product_wrap {
        min-height: 41.25rem;
        height: 86svh;
        width: 65vw;
        flex-basis: 65vw;
        padding: 2.75rem 1.75rem 2.1875rem;
      }
    }
    @media (max-width: 56.25rem), (max-height: 38.75rem) {
      .coffee-product_wrap h3 {
        font-size: 2.8125rem;
      }
    }
    @media (max-width: 56.25rem), (max-height: 38.75rem) {
      .coffee-product_watermark {
        font-size: 17vw;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-product_wrap {
        width: 90vw;
        flex-basis: 90vw;
        min-height: 40.625rem;
        height: 86svh;
        max-height: 50rem;
        padding: 2.75rem 1.5rem 2.1875rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-product_head {
        padding-right: 3rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-product_wrap h3 {
        font-size: clamp(2.3125rem, 10.2vw, 3.125rem);
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-product_notes {
        font-size: 0.75rem;
        max-width: 13.125rem;
        margin-bottom: 1rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-product_origin {
        font-size: 0.75rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-product_quick-add {
        width: 2.6875rem;
        height: 2.6875rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-product_visual {
        padding: 0.625rem 0 0;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-product_watermark {
        font-size: 25vw;
        bottom: 6.75rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-product_price {
        font-size: 1.25rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-product_details {
        font-size: 0.75rem;
        gap: 0.5rem;
      }
    }
    @media (max-width: 37.5rem) {
      .coffee-product_sample-note {
        right: 1.5rem;
      }
    }
    .coffee-product_quick-add [hidden] {
      display: none;
    }
    .coffee-product_java {
      --product-ground: var(--brand-500);
    }
    .coffee-product_blend {
      --product-ground: var(--green-700);
      --product-ink: var(--ivory-100);
    }
    .coffee-product_ipr {
      --product-ground: var(--mint-300);
    }
    .coffee-product_java .coffee-product_visual > img {
      transform: rotate(5deg);
    }
    .coffee-product_blend .coffee-product_visual > img {
      max-height: 26.875rem;
    }
    .coffee-product_blend .coffee-options_option-row {
      border-color: var(--border-inverse);
    }
  }
</style>
