---
import CultureFilm from "@/components/section/CultureFilm.astro";
import CultureStory from "@/components/content/CultureStory.astro";

interface Props {
  render?: boolean;
}
const { render = true } = Astro.props;
---

{render && (
  <section class="culture-section_wrap people-section" id="cultura" aria-labelledby="people-title">
    <CultureFilm />
    <CultureStory />
  </section>
)}
<style is:global>
  @layer components {
    .culture-section_wrap {
      position: relative;
    }
  }
</style>
