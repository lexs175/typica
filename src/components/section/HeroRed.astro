---
import posterImage from "@/assets/images/typica-poster.jpg";
import coffeeSticker from "@/assets/stickers/coffee.svg";

interface Props {
  render?: boolean;
}
const { render = true } = Astro.props;
---

{render && (
  <div class="hero-red_outer" id="inicio">
    <section class="hero-red_wrap" aria-label="Café de especialidad en Bolivia">
      {/* Fondo multimedia con video de Typica y tinte rojo en modo multiply */}
      <div class="hero-red_media" aria-hidden="true">
        <video
          class="hero-red_video"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          poster={posterImage.src}
        >
          <source src="/videos/video-hero.mp4" type="video/mp4" />
        </video>
        <div class="hero-red_overlay"></div>
      </div>

      {/* Botón seguidor de cursor interactivo ("→ Elegir mi café") */}
      <div class="hero-red_follower" id="hero-follower">
        <a
          href="#cafes"
          class="hero-red_floating-btn"
          id="hero-floating-btn"
          aria-label="Elegir mi café"
        >
          <span class="hero-red_btn-arrow" aria-hidden="true">
            &rarr;
          </span>
          <span class="hero-red_btn-text">Elegir mi café</span>
        </a>
      </div>

      {/* Contenido en contenedor centrado al pie */}
      <div class="hero-red_container">
        <div class="hero-red_copy">
          <div class="hero-red_title-wrap">
            {/* Sticker de cafetería oficial encima del H1 */}
            <div
              class="hero-red_sticker hero-red_sticker--h1"
              aria-hidden="true"
            >
              <img
                src={coffeeSticker.src}
                alt=""
                width="128"
                height="120"
                class="hero-red_sticker-img"
              />
            </div>
            <h1 class="hero-red_title" data-transition-words>
              <span class="hero-red_title-line">
                <span class="hero-red_word" data-single-word>
                  Café
                </span>{" "}
                <span class="hero-red_word" data-single-word>
                  de
                </span>{" "}
                <span class="hero-red_word" data-single-word>
                  <em class="hero-red_italic">especialidad</em>
                </span>{" "}
                <span class="hero-red_word" data-single-word>
                  para
                </span>
              </span>
              <span class="hero-red_title-line">
                <span class="hero-red_word" data-single-word>
                  amantes
                </span>{" "}
                <span class="hero-red_word" data-single-word>
                  del
                </span>{" "}
                <span class="hero-red_word" data-single-word>
                  café
                </span>{" "}
                <span class="hero-red_word" data-single-word>
                  en
                </span>{" "}
                <span class="hero-red_word" data-single-word>
                  Bolivia
                </span>
              </span>
            </h1>
          </div>
          <p class="hero-red_subtitle">
            Somos cafetería y tostaduría de café boliviano, con desayunos,
            brunch y postres, y un equipo premiado en barismo y latte art.
          </p>
        </div>
      </div>
    </section>
  </div>
)}

<style is:global>
  /* =========================================================
     HERO OFICIAL RED TYPICA ENMARCADO (CANVAS FRAME BLANCO)
     - Desktop & Laptop (>= 1024px): Marco blanco con padding reducido
       de 12px (0.75rem) hasta 16px (1rem) con clamp y esquinas redondeadas.
     - Tablet & Móvil (< 1024px): Sin marco (padding: 0) ni esquinas
       redondeadas (border-radius: 0), 100% full bleed.
     ========================================================= */
  .hero-red_outer {
    background-color: #ffffff; /* FONDO 100% BLANCO */
    padding: clamp(0.75rem, 1vw, 1rem);
    width: 100%;
    box-sizing: border-box;
  }

  .hero-red_wrap {
    position: relative;
    width: 100%;
    min-height: calc(100svh - clamp(1.5rem, 2vw, 2rem));
    height: calc(100svh - clamp(1.5rem, 2vw, 2rem));
    max-height: 1080px;
    background-color: #ffffff; /* FONDO 100% BLANCO */
    border-radius: var(--radius-main);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-shadow: none !important;
  }

  .hero-red_media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    border-radius: var(--radius-main);
    transform-origin: center center;
    transform: scale(0);
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-red_media {
      transform: scale(1) !important;
    }
  }

  /* =========================================================
     ESTADOS INICIALES EN CSS PURO (ANTI-FOUC ARQUITECTÓNICO)
     Garantiza que NADA aparezca antes de su turno en la secuencia
     desde el primer frame de pintado del navegador (t = 0ms).
     ========================================================= */
  body:not(.inner-page):not(.intro-complete) .site-header_wrap {
    opacity: 0;
    transform: translateY(-24px);
    visibility: hidden;
    pointer-events: none;
    will-change: opacity, transform;
  }

  body:not(.intro-complete) .hero-red_floating-btn {
    transform: scale(0);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    will-change: transform, opacity;
  }

  body.intro-complete .hero-red_media {
    transform: scale(1);
  }

  body.intro-complete .hero-red_copy {
    opacity: 1;
    visibility: visible;
  }

  body.intro-complete .hero-red_floating-btn {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    body:not(.inner-page):not(.intro-complete) .site-header_wrap,
    body:not(.intro-complete) .hero-red_floating-btn {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
      pointer-events: auto !important;
    }
  }

  .hero-red_video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: none;
  }

  /* Overlay rojo oficial Typica en modo multiply con degradado inferior para legibilidad */
  .hero-red_overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgba(0, 0, 0, 0.75) 0%,
        rgba(0, 0, 0, 0.25) 45%,
        transparent 100%
      ),
      var(--red-500);
    mix-blend-mode: multiply;
    opacity: 1;
    pointer-events: none;
    z-index: 2;
  }

  /* =========================================================
     BOTÓN FLOTANTE SEGUIDOR DE CURSOR («→ Elegir mi café»)
     ========================================================= */
  .hero-red_follower {
    position: absolute;
    top: 48%;
    left: 63%;
    transform: translate(-50%, -50%);
    z-index: 15;
    pointer-events: none;
    will-change: transform;
  }

  .hero-red_floating-btn {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 11px 22px;
    background-color: #ffe52d;
    color: #000000;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.1vw, 1.18rem);
    font-weight: 700;
    text-decoration: none;
    border: 2px solid #000000;
    border-radius: var(--button-radius, 6px);
    box-shadow: -4px 4px 0px #000000;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transform: scale(0);
    opacity: 0;
    visibility: hidden;
    transform-origin: center center;
    transition:
      transform var(--button-press-duration, 160ms)
        var(--button-press-ease, cubic-bezier(0.2, 0.8, 0.2, 1)),
      box-shadow var(--button-press-duration, 160ms)
        var(--button-press-ease, cubic-bezier(0.2, 0.8, 0.2, 1)),
      background-color 0.15s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-red_floating-btn {
      transform: scale(1) !important;
      opacity: 1 !important;
      visibility: visible !important;
    }
  }

  @media (hover: hover) {
    .hero-red_floating-btn:hover {
      transform: translate(-4px, 4px);
      box-shadow: 0 0 0 transparent;
      background-color: #ffde00;
    }

    .hero-red_floating-btn:hover .hero-red_btn-arrow {
      transform: translateX(3px);
    }
  }

  .hero-red_floating-btn:active {
    transform: translate(-4px, 4px);
    box-shadow: 0 0 0 transparent;
  }

  .hero-red_floating-btn.is-hidden {
    pointer-events: none !important;
  }

  .hero-red_btn-arrow {
    font-size: 1.25em;
    line-height: 1;
    display: inline-block;
    transition: transform 160ms ease;
  }

  /* =========================================================
     CONTENIDO CENTRADO INFERIOR
     ========================================================= */
  .hero-red_container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(2rem, 3.5vw, 4rem) var(--site-margin)
      clamp(2.5rem, 4.5vw, 4.5rem);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-red_copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.2rem, 1.8vw, 1.75rem);
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    opacity: 0;
    visibility: hidden;
    will-change: opacity, transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-red_copy {
      opacity: 1 !important;
      visibility: visible !important;
    }
  }

  .hero-red_title-wrap {
    position: relative;
    display: inline-block;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    text-align: center;
  }

  /* Sticker de cafetería encima del H1 */
  .hero-red_sticker--h1 {
    position: absolute;
    top: clamp(-72px, -5.8vw, -48px);
    left: clamp(-14px, -1vw, 2px);
    transform: rotate(-10deg);
    width: clamp(60px, 5.8vw, 98px);
    z-index: 5;
    pointer-events: none;
    user-select: none;
    will-change: transform;
    transition: transform 0.25s ease;
  }

  .hero-red_sticker-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-red_title {
    font-family: var(--font-headline);
    font-size: clamp(2.4rem, 4.5vw, 4.85rem);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #ffffff;
    text-transform: none; /* Title Case */
    margin: 0;
    text-align: center;
    text-wrap: balance;
  }

  .hero-red_title-line {
    display: block;
  }

  .hero-red_word {
    display: inline-block;
    position: relative;
    transform-origin: center center;
    will-change: transform, opacity;
  }

  @media (min-width: 900px) {
    .hero-red_title-line {
      white-space: nowrap;
    }
  }

  .hero-red_italic {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 400;
    margin: 0 0.12em;
    letter-spacing: 0.02em;
  }

  .hero-red_subtitle {
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.35vw, 1.4rem);
    font-weight: 400;
    line-height: 1.35;
    color: #ffffff;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    opacity: 0.95;
    text-wrap: balance;
  }

  /* =========================================================
     TABLET Y MOBILE (< 1024px)
     EL BOTÓN SE CONVIERTE EN BOTÓN ESTÁTICO DEBAJO DEL TEXTO
     ========================================================= */
  @media (max-width: 1023px) {
    .hero-red_outer {
      padding: 0 !important;
      background-color: transparent;
    }

    .hero-red_wrap {
      border-radius: 0 !important;
      height: auto;
      min-height: 100svh;
      max-height: none;
      padding-top: 7rem;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }

    .hero-red_container {
      order: 1;
      padding-bottom: 0.5rem;
    }

    .hero-red_follower {
      position: static !important;
      transform: none !important;
      order: 2;
      display: flex !important;
      justify-content: center !important;
      margin-top: 0.75rem !important;
      margin-bottom: clamp(2rem, 4vw, 3.5rem) !important;
      pointer-events: auto !important;
      z-index: 5;
    }

    .hero-red_floating-btn {
      position: relative !important;
      pointer-events: auto !important;
      display: inline-flex !important;
    }
  }

  @media (max-width: 480px) {
    .hero-red_wrap {
      padding-top: 5.5rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { BREAKPOINTS } from "@/scripts/breakpoints";

  // 1. Control del video
  const heroVideo = document.querySelector<HTMLVideoElement>(".hero-red_video");
  const heroMedia = document.querySelector<HTMLElement>(".hero-red_media");
  const heroOverlay = document.querySelector<HTMLElement>(".hero-red_overlay");
  if (heroVideo) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      heroVideo.pause();
    } else {
      heroVideo.play().catch(() => {});
    }
  }

  // 2. Animación de entradas: Expansión de video con clip-path + entradas tipográficas estilo Truus.co
  const words = document.querySelectorAll<HTMLElement>(
    ".hero-red_wrap [data-single-word]",
  );
  const sticker = document.querySelector<HTMLElement>(".hero-red_sticker--h1");
  const subtitle = document.querySelector<HTMLElement>(".hero-red_subtitle");
  const heroWrap = document.querySelector<HTMLElement>(".hero-red_wrap");
  const followerEl = document.querySelector<HTMLElement>("#hero-follower");
  const floatingBtn = document.querySelector<HTMLElement>("#hero-floating-btn");
  const heroCopy = document.querySelector<HTMLElement>(".hero-red_copy");
  const navHeader = document.querySelector<HTMLElement>(".site-header_wrap");

  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!prefersReduced && words.length > 0 && heroMedia) {
    // Inicializar el video en escala 0 en el centro exacto
    gsap.set(heroMedia, { scale: 0, transformOrigin: "center center" });
    if (floatingBtn) gsap.set(floatingBtn, { opacity: 0, scale: 0 });
    if (heroCopy) gsap.set(heroCopy, { opacity: 0, visibility: "hidden" });

    const tl = gsap.timeline({ delay: 0.1 });

    // FASE 1: Expansión de 0% a 100% desde center center
    tl.fromTo(
      heroMedia,
      {
        scale: 0,
        transformOrigin: "center center",
      },
      {
        scale: 1,
        transformOrigin: "center center",
        duration: 1.25,
        ease: "power3.inOut",
      },
      0,
    );

    // FASE 2: Animaciones de texto y Navbar (arrancan cuando el video llega a 100% en 1.1s)
    const textStart = 1.1;

    // Hacer visible el contenedor de texto justo cuando arranca la animación de las palabras
    if (heroCopy) {
      tl.set(heroCopy, { visibility: "visible" }, textStart);
      tl.to(heroCopy, { opacity: 1, duration: 0.05 }, textStart);
    }

    // Navbar: fade in elegante cuando el video alcanza 100%
    if (navHeader) {
      tl.set(navHeader, { visibility: "visible" }, textStart);
      tl.to(
        navHeader,
        {
          opacity: 1,
          y: 0,
          duration: 0.75,
          ease: "power2.out",
        },
        textStart,
      );
    }

    // Palabras del H1: escala rápida con Expo.easeOut y rebote elástico lateral con elastic.out(1, 0.75)
    tl.from(
      words,
      {
        scale: 0,
        duration: 1,
        stagger: 0.045,
        ease: "expo.out",
      },
      textStart,
    );

    tl.from(
      words,
      {
        xPercent: 100,
        rotate: 0.001,
        duration: 1.1,
        stagger: 0.045,
        ease: "elastic.out(1, 0.75)",
      },
      "<",
    );

    // Sticker encima del H1: rota 360° y aterriza elásticamente en su ángulo (-10°)
    if (sticker) {
      tl.from(
        sticker,
        {
          scale: 0,
          xPercent: 120,
          rotate: 350,
          duration: 1.5,
          ease: "elastic.out(1, 0.75)",
        },
        "< 0.12",
      );
    }

    // Subtítulo: fade in suave y elevación
    if (subtitle) {
      tl.from(
        subtitle,
        {
          opacity: 0,
          y: 25,
          duration: 1,
          ease: "power3.out",
        },
        "-=0.9",
      );
    }

    // Botón flotante ("→ Elegir mi café"): aparece al final desde CSS oculto con pop elástico
    if (floatingBtn) {
      tl.set(floatingBtn, { visibility: "visible" }, "-=0.85");
      tl.to(
        floatingBtn,
        {
          scale: 1,
          opacity: 1,
          duration: 1.2,
          ease: "elastic.out(1, 0.75)",
        },
        "<",
      );
    }

    tl.eventCallback("onComplete", () => {
      introComplete = true;
      document.body.classList.add("intro-complete");
      if (navHeader) gsap.set(navHeader, { clearProps: "transform,opacity" });
      if (floatingBtn)
        gsap.set(floatingBtn, { clearProps: "transform,opacity" });
    });
  } else {
    document.body.classList.add("intro-complete");
  }

  // 3. Cursor follower flotante para el botón en Desktop (>= 1024px)
  let introComplete = prefersReduced;
  if (prefersReduced) {
    document.body.classList.add("intro-complete");
  }

  if (heroWrap && followerEl && floatingBtn) {
    const hasFinePointer = () =>
      window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    let isDesktop = window.innerWidth >= BREAKPOINTS.laptop && hasFinePointer();
    let isInsideHero = false;
    let isFollowerHidden = false;
    let currentX = 0;
    let currentY = 0;
    let targetX = 0;
    let targetY = 0;
    let lastClientX: number | null = null;
    let lastClientY: number | null = null;
    let rafId: number | null = null;

    // Hit-testing geométrico infalible: calcula si las coordenadas físicas del cursor
    // caen dentro del bloque de texto (incluyendo sticker y margen de seguridad) o del navbar.
    // Inmune a la dirección de entrada, velocidad del mouse o intercepciones del puntero.
    function checkForbidden(clientX: number, clientY: number): boolean {
      // 1. Zona de texto inferior (H1 + subtítulo + sticker oficial que sobresale hacia arriba)
      if (heroCopy) {
        const copyRect = heroCopy.getBoundingClientRect();
        const bufferTop = 80; // Cubre el sticker inclinado que sobresale por encima del H1
        const bufferSide = 32; // Margen lateral para evitar colisión antes de rozar el texto
        const bufferBottom = 20;

        if (
          clientX >= copyRect.left - bufferSide &&
          clientX <= copyRect.right + bufferSide &&
          clientY >= copyRect.top - bufferTop &&
          clientY <= copyRect.bottom + bufferBottom
        ) {
          return true;
        }
      }

      // 2. Zona del Navbar superior o si el dropdown está abierto
      if (
        clientY <= 120 ||
        Boolean(document.querySelector(".site-header_dropdown[open]"))
      ) {
        return true;
      }

      if (navHeader) {
        const navRect = navHeader.getBoundingClientRect();
        if (
          clientX >= navRect.left &&
          clientX <= navRect.right &&
          clientY >= navRect.top &&
          clientY <= navRect.bottom + 8
        ) {
          return true;
        }
      }

      return false;
    }

    // Animación fluida de escala y opacidad con GSAP (Emil Kowalski style)
    function setFollowerVisibility(shouldHide: boolean) {
      if (!isDesktop || !floatingBtn || !introComplete) return;

      if (shouldHide && !isFollowerHidden) {
        isFollowerHidden = true;
        floatingBtn.classList.add("is-hidden");
        gsap.to(floatingBtn, {
          scale: 0,
          opacity: 0,
          duration: 0.2,
          ease: "power2.inOut",
          overwrite: "auto",
        });
      } else if (!shouldHide && isFollowerHidden) {
        isFollowerHidden = false;
        floatingBtn.classList.remove("is-hidden");
        gsap.to(floatingBtn, {
          scale: 1,
          opacity: 1,
          duration: 0.35,
          ease: "back.out(1.6)",
          overwrite: "auto",
        });
      }
    }

    // Escuchar cambios de tamaño de ventana
    window.addEventListener(
      "resize",
      () => {
        isDesktop = window.innerWidth >= BREAKPOINTS.laptop && hasFinePointer();
        if (!isDesktop) {
          if (introComplete) {
            floatingBtn.classList.remove("is-hidden");
            gsap.set(floatingBtn, { scale: 1, opacity: 1 });
          }
          if (followerEl) followerEl.style.transform = "";
          stopCursorLoop();
        } else {
          if (lastClientX !== null && lastClientY !== null) {
            const isForbidden = checkForbidden(lastClientX, lastClientY);
            setFollowerVisibility(!isInsideHero || isForbidden);
          }
        }
      },
      { passive: true },
    );

    // Loop suave con interpolación (lerp) eficiente que se duerme cuando no hay movimiento
    function startCursorLoop() {
      if (!isDesktop || !followerEl || rafId !== null) return;
      rafId = requestAnimationFrame(updateCursor);
    }

    function stopCursorLoop() {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    }

    function updateCursor() {
      if (!isDesktop || !followerEl) {
        rafId = null;
        return;
      }

      const dx = targetX - currentX;
      const dy = targetY - currentY;

      if (Math.abs(dx) < 0.1 && Math.abs(dy) < 0.1) {
        currentX = targetX;
        currentY = targetY;
        followerEl.style.transform = `translate3d(calc(-50% + ${currentX.toFixed(2)}px), calc(-50% + ${currentY.toFixed(2)}px), 0)`;
        rafId = null; // Se duerme pacíficamente para liberar CPU/GPU
        return;
      }

      currentX += dx * 0.15;
      currentY += dy * 0.15;

      followerEl.style.transform = `translate3d(calc(-50% + ${currentX.toFixed(2)}px), calc(-50% + ${currentY.toFixed(2)}px), 0)`;
      rafId = requestAnimationFrame(updateCursor);
    }

    if (isDesktop) {
      // Posición inicial fija en el área media derecha (top: 48%, left: 63%)
      currentX = 0;
      currentY = 0;
      targetX = 0;
      targetY = 0;
      followerEl.style.transform = "translate3d(-50%, -50%, 0)";
    }

    function handlePointerPosition(clientX: number, clientY: number) {
      if (!isDesktop || !heroWrap) return;
      lastClientX = clientX;
      lastClientY = clientY;

      const heroRect = heroWrap.getBoundingClientRect();
      const inHeroBounds =
        clientX >= heroRect.left &&
        clientX <= heroRect.right &&
        clientY >= heroRect.top &&
        clientY <= heroRect.bottom;

      isInsideHero = inHeroBounds;

      if (inHeroBounds) {
        targetX = clientX - heroRect.left - heroRect.width * 0.63;
        targetY = clientY - heroRect.top - heroRect.height * 0.48;
        const isForbidden = checkForbidden(clientX, clientY);
        setFollowerVisibility(isForbidden);
        startCursorLoop();
      } else {
        setFollowerVisibility(true);
      }
    }

    // Escuchar movimiento global para un seguimiento y detección continuos
    window.addEventListener(
      "pointermove",
      (e) => {
        handlePointerPosition(e.clientX, e.clientY);
      },
      { passive: true },
    );

    heroWrap.addEventListener("pointerleave", () => {
      if (!isDesktop) return;
      isInsideHero = false;
      setFollowerVisibility(true);
      targetX = 0;
      targetY = 0;
      startCursorLoop();
    });

    // Click suave para navegar a #cafes
    floatingBtn.addEventListener("click", (e) => {
      e.preventDefault();
      const target = document.querySelector("#cafes");
      if (target) {
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }
</script>
