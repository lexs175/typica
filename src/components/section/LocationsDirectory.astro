---
import LocationCard from "@/components/item/LocationCard.astro";
import { locations } from "@/data/locations";
interface Props {
  render?: boolean;
}
const { render = true } = Astro.props;
---

{render && (
  <section
    class="locations-directory_wrap"
    aria-label="Directorio de sucursales"
  >
    <div
      class="locations-directory_city-filters"
      role="group"
      aria-label="Filtrar por ciudad"
    >
      <button type="button" data-city-filter="all" aria-pressed="true">
        Todas
      </button>
      <button type="button" data-city-filter="la-paz" aria-pressed="false">
        La Paz
      </button>
      <button type="button" data-city-filter="cochabamba" aria-pressed="false">
        Cochabamba
      </button>
      <button type="button" data-city-filter="santa-cruz" aria-pressed="false">
        Santa Cruz
      </button>
      <button type="button" data-city-filter="mas" aria-pressed="false">
        Más ciudades
      </button>
    </div>
    <p
      class="sr-only"
      id="location-status"
      role="status"
      aria-live="polite"
    ></p>
    <div class="locations-directory_layout">
      <LocationCard
        location={locations.find((location) => location.id === "la-paz")!}
      />
      <LocationCard
        location={locations.find((location) => location.id === "cochabamba")!}
      />
      <LocationCard
        location={locations.find((location) => location.id === "santa-cruz")!}
      />
    </div>
    <div class="locations-directory_more-locations" id="mas-casas">
      <article class="locations-directory_city" id="oruro" data-city="oruro">
        <p>Bolivia</p>
        <h2>Oruro</h2>
        <p>Soria Galvarro · Junín</p>
        <a
          href="https://www.typica.com.bo/locales"
          target="_blank"
          rel="noopener"
        >
          Ver sucursales{" "}
          <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <path
              d="M5 16h21M17 6l10 10-10 10"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </a>
      </article>
      <article class="locations-directory_city" id="sucre" data-city="sucre">
        <p>Bolivia</p>
        <h2>Sucre</h2>
        <p>Azurduy</p>
        <a
          href="https://www.typica.com.bo/locales"
          target="_blank"
          rel="noopener"
        >
          Ver sucursales{" "}
          <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <path
              d="M5 16h21M17 6l10 10-10 10"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </a>
      </article>
      <article
        class="locations-directory_city"
        id="asuncion"
        data-city="asuncion"
      >
        <p>Paraguay</p>
        <h2>Asunción</h2>
        <p>Asunción</p>
        <a
          href="https://www.typica.com.bo/locales"
          target="_blank"
          rel="noopener"
        >
          Ver sucursales{" "}
          <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <path
              d="M5 16h21M17 6l10 10-10 10"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </a>
      </article>
      <article
        class="locations-directory_city"
        id="florianopolis"
        data-city="florianopolis"
      >
        <p>Brasil</p>
        <h2>Florianópolis</h2>
        <p>Florianópolis</p>
        <a
          href="https://www.typica.com.bo/locales"
          target="_blank"
          rel="noopener"
        >
          Ver sucursales{" "}
          <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <path
              d="M5 16h21M17 6l10 10-10 10"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </a>
      </article>
    </div>
    <p class="locations-directory_directory-note">
      Consulta dirección, horario y carta de cada casa en el directorio oficial
      de Typica.
    </p>
  </section>
)}
<style is:global>
  @layer components {
    .locations-directory_wrap {
      padding: 0 var(--gutter) 6.25rem;
    }
    .locations-directory_city-filters {
      display: flex;
      gap: 0.625rem;
      flex-wrap: wrap;
      margin-bottom: 2.125rem;
    }
    .locations-directory_city-filters button {
      min-height: 2.875rem;
      padding: 0.625rem 1.25rem;
      border-radius: 1.875rem;
      background: var(--neutral-200);
      font-size: 0.875rem;
      font-weight: 600;
    }
    .locations-directory_city-filters button[aria-pressed="true"] {
      background: var(--ink);
      color: var(--light-100);
    }
    .locations-directory_layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.75rem 1.375rem;
    }
    .locations-directory_more-locations {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.375rem;
      padding-top: 4.0625rem;
      scroll-margin-top: 6.5625rem;
    }
    .locations-directory_city {
      background: var(--neutral-250);
      padding: 1.75rem;
      scroll-margin-top: 6.5625rem;
    }
    .locations-directory_city h2 {
      font-size: clamp(1.5625rem, 2.7vw, 2.625rem);
      line-height: 1.05;
      letter-spacing: -0.05em;
      margin: 1rem 0;
    }
    .locations-directory_city > p {
      font-size: 0.8125rem;
      line-height: 1.6;
    }
    .locations-directory_city > a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      font-size: 0.8125rem;
      font-weight: 650;
      margin-top: 1.375rem;
      min-height: 2.75rem;
    }
    .locations-directory_city > a svg {
      width: 1.25rem;
      height: 1.25rem;
    }
    .locations-directory_directory-note {
      margin-top: 2.1875rem;
      font-size: 0.8125rem;
    }
    .locations-directory_wrap [hidden] {
      display: none !important;
    }
    @media (max-width: 68.75rem) {
      .locations-directory_more-locations {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (max-width: 47.5rem) {
      .locations-directory_city-filters {
        gap: 0.5rem;
      }
    }
    @media (max-width: 47.5rem) {
      .locations-directory_city-filters button {
        padding: 0.625rem 0.9375rem;
        font-size: 0.75rem;
      }
    }
    @media (max-width: 47.5rem) {
      .locations-directory_layout {
        grid-template-columns: 1fr;
        gap: 2.1875rem;
      }
    }
    @media (max-width: 47.5rem) {
      .locations-directory_more-locations {
        gap: 0.75rem;
        padding-top: 2.625rem;
      }
    }
    @media (max-width: 47.5rem) {
      .locations-directory_city {
        padding: 1.4375rem 1.125rem;
      }
    }
    @media (max-width: 47.5rem) {
      .locations-directory_city h2 {
        font-size: 1.6875rem;
        overflow-wrap: anywhere;
      }
    }
    @media (max-width: 47.5rem) {
      .locations-directory_city > a {
        font-size: 0.75rem;
        gap: 0.375rem;
      }
    }
  }
</style>

<script>
  import "@/scripts/experiences.js";
</script>
