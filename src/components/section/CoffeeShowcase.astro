---
import CoffeeCover from "@/components/content/CoffeeCover.astro";
import CoffeeProduct from "@/components/item/CoffeeProduct.astro";
import { coffees } from "@/data/coffees";
interface Props {
  render?: boolean;
}
const { render = true } = Astro.props;
---

{render && (
  <section
    class="coffee-showcase_wrap"
    id="cafes"
    aria-labelledby="coffee-scene-title"
  >
    <div
      class="coffee-showcase_viewport"
      tabindex="0"
      role="region"
      aria-label="Cafés en bolsa. Desliza para explorar."
    >
      <div class="coffee-showcase_track">
        <CoffeeCover />
        <div class="coffee-products_grid">
          {coffees.map((coffee) => (
            <CoffeeProduct coffee={coffee} />
          ))}
        </div>
      </div>
      <div
        class="coffee-showcase_rail-nav"
        role="group"
        aria-label="Recorrer los cafés"
      >
        <button
          type="button"
          data-coffee-step="-1"
          aria-label="Café anterior"
          disabled
        >
          <span style="display:flex;transform:rotate(180deg)">
            <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <path
                d="M5 16h21M17 6l10 10-10 10"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </span>
        </button>
        <button type="button" data-coffee-step="1" aria-label="Café siguiente">
          <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <path
              d="M5 16h21M17 6l10 10-10 10"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </section>
)}
<style is:global>
  @layer components {
    @media (min-width: 56.3125rem) and (min-height: 38.8125rem) and (prefers-reduced-motion: no-preference) {
      .coffee-showcase_wrap .coffee-showcase_rail-nav {
        display: none;
      }
    }
    .coffee-showcase_wrap {
      position: relative;
      background: #ffffff;
      color: var(--ink);
      width: 100vw;
      height: 100svh;
      overflow: hidden;
    }
    .coffee-showcase_viewport {
      position: relative;
      width: 100%;
      height: 100%;
      overflow-x: auto;
    }
    .coffee-showcase_track {
      display: flex;
      align-items: stretch;
      width: max-content;
    }
    .coffee-showcase_wrap.is-scroll-driven .coffee-showcase_viewport {
      overflow: hidden;
    }
    .coffee-showcase_rail-nav {
      position: absolute;
      right: 1.5rem;
      bottom: 6.25rem;
      z-index: 3;
      display: flex;
      gap: 0.5rem;
    }
    .coffee-showcase_rail-nav button {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      background: var(--light-100);
      color: var(--neutral-900);
      border-radius: 50%;
    }
    .coffee-showcase_rail-nav svg {
      width: 1.375rem;
      height: 1.375rem;
    }
    .coffee-showcase_rail-nav button:disabled {
      opacity: 0.3;
      cursor: default;
    }
    .coffee-showcase_viewport:has(.coffee-product_wrap.is-open)
      .coffee-showcase_rail-nav {
      display: none;
    }
    .coffee-products_grid {
      display: contents;
    }
    @media (max-width: 1023px) {
      .coffee-showcase_wrap {
        width: 100%;
        height: auto;
        min-height: 0;
        overflow: visible;
      }
      .coffee-showcase_viewport {
        width: 100%;
        height: auto;
        overflow: visible;
      }
      .coffee-showcase_track {
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 100%;
        transform: none !important;
      }
      /* Tablet (768px a 1023px): 2 columnas exactas */
      .coffee-products_grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        width: 100%;
        gap: 0;
      }
      .coffee-showcase_rail-nav {
        display: none !important;
      }
    }
    /* Mobile (< 768px): 1 sola columna para visualización completa limpia */
    @media (max-width: 767px) {
      .coffee-products_grid {
        display: grid;
        grid-template-columns: 1fr;
        width: 100%;
        gap: 0;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .coffee-showcase_viewport {
        overflow-x: auto;
        scroll-snap-type: x mandatory;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .coffee-showcase_rail-nav {
        display: none;
      }
    }
  }
</style>

<script>
  import "@/scripts/coffee-showcase.js";
</script>
