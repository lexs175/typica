---
import logo from "@/assets/logo/logo.svg";

interface Props {
  render?: boolean;
}
const { render = true } = Astro.props;
---

{render && (
  <header class="site-header_wrap" id="nav">
    <div class="site-header_bar">
      <nav class="site-header_primary" aria-label="Navegación principal">
        <a class="site-header_link" href="/#cafes">Cafés en bolsa</a>
        <details class="site-header_dropdown">
          <summary class="site-header_link">
            Sucursales{" "}
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="m4 6 4 4 4-4"
                stroke="currentColor"
                stroke-width="1.5"
              ></path>
            </svg>
          </summary>
          <div class="site-header_dropdown-panel">
            <a class="site-header_dropdown-link" href="/sucursales/">
              Todas las sucursales <span>↗</span>
            </a>
            <a class="site-header_dropdown-link" href="/sucursales/#la-paz">La Paz</a>
            <a class="site-header_dropdown-link" href="/sucursales/#cochabamba">Cochabamba</a>
            <a class="site-header_dropdown-link" href="/sucursales/#santa-cruz">Santa Cruz</a>
            <a class="site-header_dropdown-link" href="/sucursales/#mas-casas">Más ciudades</a>
          </div>
        </details>
        <a class="site-header_link" href="/suscripciones/">Suscripciones</a>
        <a class="site-header_link" href="/#cultura">Cultura</a>
      </nav>
      <a
        class="site-header_wordmark"
        href="/#inicio"
        aria-label="Typica, inicio"
      >
        <img
          src={logo.src}
          alt="Typica Café Tostaduría"
          width="126"
          height="48"
        />
      </a>
      <div class="site-header_tools">
        <button
          class="site-header_cart"
          id="cart-toggle"
          aria-label="Abrir carrito, 0 bolsas"
          aria-haspopup="dialog"
          aria-controls="cart-dialog"
        >
          <span class="site-header_icon">
            <svg viewBox="0 0 28 30" fill="none" aria-hidden="true">
              <path
                d="M5 9h18l2 18H3L5 9Z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"
              ></path>
              <path
                d="M9 11V6a5 5 0 0 1 10 0v5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              ></path>
            </svg>
            <span class="site-header_count" aria-hidden="true">
              0
            </span>
          </span>
          <span class="site-header_word">Carrito</span>
        </button>
        <button
          class="site-header_toggle"
          id="menu-toggle"
          aria-expanded="false"
          aria-controls="menu"
        >
          <span>menú</span>
          <span class="site-header_burger" aria-hidden="true">
            <i></i>
            <i></i>
          </span>
        </button>
      </div>
    </div>
  </header>
)}
<style is:global>
  @layer components {
    .site-header_wrap {
      position: fixed;
      inset: 1.5625rem var(--gutter) auto;
      z-index: 80;
      transition: transform 0.35s;
    }
    .site-header_bar {
      min-height: 4.25rem;
      padding: 0.5rem 1.125rem;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      background: var(--white);
      border: 0.0625rem solid var(--ink);
      border-radius: 0.75rem;
    }
    .site-header_contact {
      width: 2.3125rem;
      height: 2.3125rem;
      display: block;
    }
    .site-header_contact svg {
      width: 100%;
      height: 100%;
    }
    .site-header_wordmark {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.125rem;
    }
    .site-header_wordmark > span {
      font-size: 1.5625rem;
      font-weight: 900;
      letter-spacing: 0.38em;
      padding-left: 0.38em;
      line-height: 1;
    }
    .site-header_wordmark > small {
      font-size: 0.5625rem;
      font-weight: 700;
      letter-spacing: 0.22em;
    }
    .site-header_toggle {
      justify-self: end;
      display: flex;
      align-items: center;
      gap: 0.625rem;
      font-size: 1.375rem;
      font-weight: 700;
      letter-spacing: -0.05em;
    }
    .site-header_burger {
      width: 1.4375rem;
      height: 1.125rem;
      position: relative;
      display: block;
    }
    .site-header_burger i {
      position: absolute;
      height: 0.125rem;
      width: 100%;
      background: currentColor;
      left: 0;
      top: 0.3125rem;
    }
    .site-header_burger i:last-child {
      top: 0.8125rem;
    }
    .site-header_wordmark > img {
      width: 7.5rem;
      height: 2.6875rem;
      object-fit: contain;
    }
    @media (max-width: 43.75rem) {
      .site-header_wrap {
        inset: 0.9375rem var(--gutter) auto;
      }
    }
    @media (max-width: 43.75rem) {
      .site-header_bar {
        min-height: 3.625rem;
        padding: 0.4375rem 0.75rem;
        border-radius: 0.5625rem;
      }
    }
    @media (max-width: 43.75rem) {
      .site-header_contact {
        width: 1.9375rem;
        height: 1.9375rem;
      }
    }
    @media (max-width: 43.75rem) {
      .site-header_wordmark > img {
        width: 6.1875rem;
        height: 2.3125rem;
      }
    }
    @media (max-width: 43.75rem) {
      .site-header_toggle {
        font-size: 1.125rem;
        gap: 0.4375rem;
      }
    }
    .site-header_wrap {
      transform: none !important;
    }
    .site-header_wrap .site-header_bar {
      grid-template-columns: 1fr auto 1fr;
    }
    .site-header_wrap .site-header_wordmark {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
    }
    .site-header_wrap .site-header_primary {
      grid-column: 2;
      grid-row: 1;
      justify-self: center;
      gap: 1.5625rem;
      padding: 0 1.6875rem;
      height: 3.25rem;
      border-radius: 3.125rem;
      background: var(--light-100);
      color: var(--ink);
    }
    .site-header_wrap .site-header_primary a,
    .site-header_wrap .site-header_link,
    .site-header_dropdown summary {
      font-size: 0.875rem;
      font-weight: 650;
      letter-spacing: -0.035em;
      text-decoration: none !important;
    }
    .site-header_wrap .site-header_primary a:hover,
    .site-header_wrap .site-header_link:hover,
    .site-header_dropdown summary:hover {
      text-decoration: underline !important;
    }
    .site-header_wrap .site-header_tools {
      grid-column: 3;
      grid-row: 1;
    }
    .site-header_wrap .site-header_cart {
      height: 3.25rem;
      border-radius: 3.125rem;
      padding: 0 1.1875rem;
      background: var(--ink);
      color: var(--light-100);
    }
    .site-header_wrap .site-header_count {
      background: var(--light-100);
      color: var(--ink);
    }
    .site-header_dropdown {
      position: relative;
    }
    .site-header_dropdown summary {
      display: flex;
      align-items: center;
      gap: 0.4375rem;
      min-height: 3.25rem;
      cursor: pointer;
      list-style: none;
    }
    .site-header_dropdown summary::-webkit-details-marker {
      display: none;
    }
    .site-header_dropdown summary > svg {
      width: 0.9375rem;
      height: 0.9375rem;
      transition: transform 180ms ease;
    }
    .site-header_dropdown[open] summary > svg {
      transform: rotate(180deg);
    }
    .site-header_dropdown-panel {
      position: absolute;
      top: 100%;
      left: -1.375rem;
      min-width: 14.6875rem;
      padding: 0.875rem;
      background: var(--light-100);
      color: var(--neutral-900);
      border-radius: 1.125rem;
      box-shadow: 0 0.75rem 1.875rem var(--wash-soft);
    }
    .site-header_dropdown-panel a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.8125rem 0.875rem;
      border-radius: 0.5625rem;
      white-space: nowrap;
    }
    .site-header_dropdown-panel a:first-child {
      background: var(--yellow);
      margin-bottom: 0.3125rem;
    }
    .site-header_dropdown-panel a:hover {
      background: var(--neutral-100);
      text-decoration: none;
    }
    .site-header_dropdown-panel a:first-child:hover {
      background: var(--yellow);
    }
    .site-header_dropdown summary:focus-visible {
      outline: 0.1875rem solid var(--ink);
      outline-offset: 0.25rem;
    }
    .site-header_wrap:has(.site-header_dropdown[open]) {
      transform: none !important;
      pointer-events: auto;
    }
    @media (min-width: 68.8125rem) {
      .site-header_wrap .site-header_toggle {
        display: none;
      }
    }
    @media (min-width: 68.8125rem) {
      .site-header_overlay-open .site-header_wrap .site-header_toggle {
        display: flex;
      }
    }
    @media (max-width: 68.75rem) {
      .site-header_wrap .site-header_primary {
        gap: 1.125rem;
        padding: 0 1.375rem;
      }
    }
    @media (max-width: 68.75rem) {
      .site-header_wrap .site-header_primary > a:last-child {
        display: none;
      }
    }
    @media (max-width: 68.75rem) {
      .site-header_wrap .site-header_primary a,
      .site-header_dropdown summary {
        font-size: 0.8125rem;
      }
    }
    @media (max-width: 68.75rem) {
      .site-header_wrap .site-header_tools {
        gap: 0.3125rem;
      }
    }
    @media (max-width: 68.75rem) {
      .site-header_wrap .site-header_cart {
        padding: 0 0.875rem;
      }
    }
    @media (max-width: 68.75rem) {
      .site-header_wrap .site-header_word {
        display: none;
      }
    }
    @media (max-width: 68.75rem) {
      .site-header_wrap .site-header_toggle {
        min-width: 5.625rem;
        padding-inline: 0.75rem;
        font-size: 1rem;
      }
    }
    @media (max-width: 47.5rem) {
      .site-header_wrap .site-header_bar {
        grid-template-columns: 1fr auto;
      }
    }
    @media (max-width: 47.5rem) {
      .site-header_wrap .site-header_primary {
        display: none;
      }
    }
    @media (max-width: 47.5rem) {
      .site-header_wrap .site-header_tools {
        grid-column: 2;
      }
    }
    @media (max-width: 47.5rem) {
      .site-header_wrap .site-header_wordmark {
        padding-inline: 0;
        width: auto;
      }
    }
    .site-header_wrap {
      --nav-ink: var(--ink);
      --nav-ground: var(--white);
      inset: 1.125rem var(--gutter) auto;
      color: var(--nav-ink);
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .site-header_wrap[data-tone="light"] {
      --nav-ink: var(--white);
      --nav-ground: var(--ink);
    }
    .site-header_overlay-open .site-header_wrap {
      --nav-ink: var(--ink);
      --nav-ground: var(--white);
    }
    .site-header_wrap.site-header_is-hidden {
      transform: translateY(calc(-100% - 1.75rem)) !important;
      pointer-events: none;
    }
    .site-header_bar {
      min-height: 3.5rem;
      padding: 0;
      gap: 1.25rem;
      border: 0;
      border-radius: 0;
      background: transparent;
    }
    .site-header_primary {
      justify-self: start;
      display: flex;
      align-items: center;
      gap: 1.75rem;
      height: 3.5rem;
      padding: 0;
      background: transparent;
    }
    .site-header_primary a {
      font-size: 1.0625rem;
      font-weight: 750;
      letter-spacing: -0.03em;
      text-decoration: none;
      text-decoration-thickness: 0.125rem;
      text-underline-offset: 0.4375rem;
    }
    .site-header_primary a:hover {
      text-decoration: underline;
    }
    .site-header_wrap .site-header_wordmark {
      height: 3.5rem;
      padding: 0.4375rem 0;
      justify-content: center;
      background: transparent;
    }
    .site-header_wrap .site-header_wordmark > img {
      width: 7.625rem;
      height: 2.5rem;
    }
    .site-header_wrap[data-tone="light"] .site-header_wordmark > img {
      filter: invert(1);
    }
    .site-header_overlay-open .site-header_wrap .site-header_wordmark > img {
      filter: none;
    }
    .site-header_tools {
      justify-self: end;
      display: flex;
      align-items: center;
      gap: 0.5625rem;
    }
    .site-header_cart {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      height: 3.5rem;
      padding: 0 0.75rem;
      background: transparent;
      font-size: 1rem;
      font-weight: 700;
    }
    .site-header_icon {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .site-header_icon > svg {
      width: 1.375rem;
      height: 1.5625rem;
      display: block;
    }
    .site-header_count {
      position: absolute;
      top: -0.4375rem;
      right: -0.4375rem;
      min-width: 1.125rem;
      height: 1.125rem;
      padding: 0 0.25rem;
      display: grid;
      place-items: center;
      border-radius: 62.4375rem;
      background: var(--nav-ink);
      color: var(--nav-ground);
      font-size: 0.6875rem;
      font-weight: 700;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    .site-header_wrap .site-header_toggle {
      gap: 0.9375rem;
      height: 3.5rem;
      min-width: 7.25rem;
      justify-content: center;
      padding: 0 1.125rem;
      background: var(--yellow);
      color: var(--ink);
      font-size: 1.1875rem;
      letter-spacing: -0.03em;
      border-radius: var(--button-radius);
    }
    .site-header_wrap .site-header_burger {
      width: 1.375rem;
    }
    .site-header_overlay-open .site-header_primary {
      visibility: hidden;
    }
    .site-header_toggle.is-open .site-header_burger i:first-child {
      transform: translateY(0.25rem) rotate(45deg);
    }
    .site-header_toggle.is-open .site-header_burger i:last-child {
      transform: translateY(-0.25rem) rotate(-45deg);
    }
    @media (max-width: 56.25rem) {
      .site-header_wrap {
        inset: 0.875rem var(--gutter) auto;
      }
    }
    @media (max-width: 56.25rem) {
      .site-header_bar {
        gap: 0.625rem;
      }
    }
    @media (max-width: 56.25rem) {
      .site-header_primary {
        padding: 0 0.9375rem;
        gap: 1.125rem;
      }
    }
    @media (max-width: 56.25rem) {
      .site-header_wrap .site-header_wordmark {
        padding: 0.5rem 0.9375rem;
      }
    }
    @media (max-width: 56.25rem) {
      .site-header_cart {
        padding: 0 0.75rem;
        gap: 0.375rem;
      }
    }
    @media (max-width: 56.25rem) {
      .site-header_word {
        display: none;
      }
    }
    @media (max-width: 40.625rem) {
      .site-header_wrap {
        inset: 0.75rem 1.125rem auto;
      }
    }
    @media (max-width: 40.625rem) {
      .site-header_bar {
        grid-template-columns: 1fr auto;
        gap: 0.5rem;
        min-height: 3.125rem;
      }
    }
    @media (max-width: 40.625rem) {
      .site-header_primary {
        display: none;
      }
    }
    @media (max-width: 40.625rem) {
      .site-header_wrap .site-header_wordmark {
        justify-self: start;
        width: 8.125rem;
        height: 3.125rem;
        padding: 0.375rem 0.8125rem;
      }
    }
    @media (max-width: 40.625rem) {
      .site-header_wrap .site-header_wordmark > img {
        width: 6.5rem;
        height: 2.3125rem;
      }
    }
    @media (max-width: 40.625rem) {
      .site-header_tools {
        gap: 0.4375rem;
      }
    }
    @media (max-width: 40.625rem) {
      .site-header_cart {
        gap: 0.3125rem;
        height: 3.125rem;
        padding: 0 0.625rem;
      }
    }
    @media (max-width: 40.625rem) {
      .site-header_icon > svg {
        width: 1.1875rem;
        height: 1.4375rem;
      }
    }
    @media (max-width: 40.625rem) {
      .site-header_count {
        top: -0.375rem;
        right: -0.4375rem;
        min-width: 1rem;
        height: 1rem;
        padding: 0 0.1875rem;
        font-size: 0.625rem;
      }
    }
    @media (max-width: 40.625rem) {
      .site-header_wrap .site-header_toggle {
        height: 3.125rem;
        min-width: 5.5625rem;
        padding: 0 0.75rem;
        gap: 0.5rem;
        font-size: 1.0625rem;
      }
    }
    @media (max-width: 40.625rem) {
      .site-header_wrap .site-header_burger {
        width: 1.1875rem;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .site-header_wrap {
        transition: none;
      }
    }
  }
</style>

<script>
  import "@/scripts/navigation.js";
</script>
