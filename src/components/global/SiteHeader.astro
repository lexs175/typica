---
import logoWhite from "@/assets/logo/typica-logo-white.svg";
import logoDark from "@/assets/logo/logo.svg";
import chevronDownIcon from "@/assets/icons/chevron-down-white.svg";
import Button from "@/components/Button.astro";

import laPazImage from "@/assets/images/film/door-casa-1.webp";
import cochabambaImage from "@/assets/images/cochabamba.avif";
import santaCruzImage from "@/assets/images/santa-cruz.avif";

import oruroImage from "@/assets/images/sopo-1.avif";
import sucreImage from "@/assets/images/san-miguel.avif";
import paraguayImage from "@/assets/images/barra.avif";
import brasilImage from "@/assets/images/sopo-3.jpg";

interface Props {
  render?: boolean;
}
const { render = true } = Astro.props;
---

{render && (
  <header class="site-header_wrap" id="nav">
    <div class="site-header_bar">
      {/* 1. Logo Typica (Izquierda) */}
      <a
        class="site-header_wordmark"
        href="/#inicio"
        aria-label="Typica, inicio"
      >
        <img
          src={logoWhite.src}
          alt="Typica Café Tostaduría"
          width="122"
          height="40"
          class="site-header_logo site-header_logo--white"
        />
        <img
          src={logoDark.src}
          alt="Typica Café Tostaduría"
          width="122"
          height="40"
          class="site-header_logo site-header_logo--dark"
        />
      </a>

      {/* 2. Navegación Principal (Centro) - Sin pastillas, visuales (solo Home navega) */}
      <nav class="site-header_primary" aria-label="Navegación principal">
        <a class="site-header_link site-header_link--static" href="javascript:void(0)" onclick="event.preventDefault(); return false;" role="link" aria-disabled="true">Cafés en bolsa</a>
        <details class="site-header_dropdown" id="site-header-dropdown">
          <summary class="site-header_link" aria-haspopup="true">
            <span>Sucursales</span>
            <img
              src={chevronDownIcon.src}
              alt=""
              width="15"
              height="15"
              class="site-header_chevron"
              aria-hidden="true"
            />
          </summary>
          <div class="site-header_mega-menu" role="region" aria-label="Sucursales por ciudad">
            <div class="mega-menu_inner">
              <div class="mega-menu_grid">
                <!-- Columna 1: La Paz -->
                <div class="mega-menu_col">
                  <a class="mega-menu_card" href="javascript:void(0)" onclick="event.preventDefault(); return false;">
                    <div class="mega-menu_media">
                      <img
                        src={laPazImage.src}
                        alt="Casa Typica en La Paz"
                        class="mega-menu_img"
                        loading="lazy"
                      />
                    </div>
                    <div class="mega-menu_info">
                      <h3 class="mega-menu_city">La Paz</h3>
                      <p class="mega-menu_desc">5 sucursales Sopocachi, San Miguel, Centro histórico, Satélite y Achumani.</p>
                    </div>
                  </a>
                </div>

                <!-- Columna 2: Cochabamba -->
                <div class="mega-menu_col">
                  <a class="mega-menu_card" href="javascript:void(0)" onclick="event.preventDefault(); return false;">
                    <div class="mega-menu_media">
                      <img
                        src={cochabambaImage.src}
                        alt="Casa Typica en Cochabamba"
                        class="mega-menu_img"
                        loading="lazy"
                      />
                    </div>
                    <div class="mega-menu_info">
                      <h3 class="mega-menu_city">Cochabamba</h3>
                      <p class="mega-menu_desc">4 sucursales España, Fidel Anze, Portales y Cala Cala con jardín y calma.</p>
                    </div>
                  </a>
                </div>

                <!-- Columna 3: Santa Cruz -->
                <div class="mega-menu_col">
                  <a class="mega-menu_card" href="javascript:void(0)" onclick="event.preventDefault(); return false;">
                    <div class="mega-menu_media">
                      <img
                        src={santaCruzImage.src}
                        alt="Casa Typica en Santa Cruz"
                        class="mega-menu_img"
                        loading="lazy"
                      />
                    </div>
                    <div class="mega-menu_info">
                      <h3 class="mega-menu_city">Santa Cruz</h3>
                      <p class="mega-menu_desc">Equipetrol, Sirari, Palermo y Monseñor con terraza tropical.</p>
                    </div>
                  </a>
                </div>

                <!-- Columna 4: Lista Oruro, Sucre, Paraguay, Brasil -->
                <div class="mega-menu_col mega-menu_col--list">
                  <a class="mega-menu_list-item" href="javascript:void(0)" onclick="event.preventDefault(); return false;">
                    <div class="mega-menu_list-thumb">
                      <img src={oruroImage.src} alt="Typica Oruro" loading="lazy" />
                    </div>
                    <div class="mega-menu_list-info">
                      <h4 class="mega-menu_list-title">Oruro</h4>
                      <p class="mega-menu_list-desc">2 Sucursales Soria galvarro y Junin</p>
                    </div>
                  </a>

                  <a class="mega-menu_list-item" href="javascript:void(0)" onclick="event.preventDefault(); return false;">
                    <div class="mega-menu_list-thumb">
                      <img src={sucreImage.src} alt="Typica Sucre" loading="lazy" />
                    </div>
                    <div class="mega-menu_list-info">
                      <h4 class="mega-menu_list-title">Sucre</h4>
                      <p class="mega-menu_list-desc">1 Sucursal Azurduy</p>
                    </div>
                  </a>

                  <a class="mega-menu_list-item" href="javascript:void(0)" onclick="event.preventDefault(); return false;">
                    <div class="mega-menu_list-thumb">
                      <img src={paraguayImage.src} alt="Typica Paraguay" loading="lazy" />
                    </div>
                    <div class="mega-menu_list-info">
                      <h4 class="mega-menu_list-title">Paraguay</h4>
                      <p class="mega-menu_list-desc">1 Sucursal Asunción</p>
                    </div>
                  </a>

                  <a class="mega-menu_list-item" href="javascript:void(0)" onclick="event.preventDefault(); return false;">
                    <div class="mega-menu_list-thumb">
                      <img src={brasilImage.src} alt="Typica Brasil" loading="lazy" />
                    </div>
                    <div class="mega-menu_list-info">
                      <h4 class="mega-menu_list-title">Brasil</h4>
                      <p class="mega-menu_list-desc">1 Sucursal Florianópolis</p>
                    </div>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </details>
        <a class="site-header_link site-header_link--static" href="javascript:void(0)" onclick="event.preventDefault(); return false;" role="link" aria-disabled="true">Suscripciones</a>
        <a class="site-header_link site-header_link--static" href="javascript:void(0)" onclick="event.preventDefault(); return false;" role="link" aria-disabled="true">Cultura</a>
      </nav>

      {/* 3. Herramientas: Carrito Sticker Amarillo Figma Node 219:612 (Derecha) */}
      <div class="site-header_tools">
        <Button
          variant="cart"
          id="cart-toggle"
          class="site-header_cart"
          aria-label="Abrir carrito, 0 bolsas"
          aria-haspopup="dialog"
          aria-controls="cart-dialog"
        >
          Carrito
        </Button>

        <button
          class="site-header_toggle"
          id="menu-toggle"
          aria-expanded="false"
          aria-controls="menu"
        >
          <span>menú</span>
          <span class="site-header_burger" aria-hidden="true">
            <i></i>
            <i></i>
          </span>
        </button>
      </div>
    </div>
  </header>
)}

<style is:global>
  /* =========================================================
     CABECERA OFICIAL TYPICA (FIGMA NODE 219:558)
     SIN PASTILLAS - TOTALMENTE TRANSPARENTE
     ========================================================= */
  .site-header_wrap {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 80;
    pointer-events: none;
    padding-top: var(--space-4);
    padding-inline: var(--site-margin);
    box-sizing: border-box;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header_wrap.site-header_is-hidden {
    transform: translateY(calc(-100% - 2.5rem)) !important;
    pointer-events: none;
  }

  .site-header_bar {
    width: 100%;
    min-height: 3.5rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    padding: 0;
  }

  /* 1. Logo Typica */
  .site-header_wordmark {
    grid-column: 1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    pointer-events: auto;
  }

  .site-header_logo {
    width: 7.625rem;
    height: 2.5rem;
    object-fit: contain;
    display: block;
  }

  .site-header_logo--white {
    display: block;
  }

  .site-header_logo--dark {
    display: none;
  }

  /* Tone switcher when scrolled over light sections */
  .site-header_wrap[data-tone="dark"] .site-header_logo--white {
    display: none;
  }
  .site-header_wrap[data-tone="dark"] .site-header_logo--dark {
    display: block;
  }

  /* 2. Navegación Principal en el Centro (SIN PASTILLA) */
  .site-header_primary {
    grid-column: 2;
    justify-self: center;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    padding: 0;
    pointer-events: auto;
  }

  .site-header_link {
    font-family: var(--font-headline);
    font-size: var(--text-caption);
    font-weight: var(--primary-bold);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--light-100);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity var(--hover-duration) var(--hover-ease);
  }

  .site-header_link--static {
    cursor: default;
  }

  @media (hover: hover) {
    .site-header_link:hover {
      opacity: 0.8;
    }
  }

  .site-header_wrap[data-tone="dark"] .site-header_link {
    color: var(--dark-900);
  }

  /* Dropdown & Mega Menú Sucursales */
  .site-header_dropdown {
    position: static;
  }

  .site-header_dropdown summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    cursor: pointer;
  }

  .site-header_dropdown summary::-webkit-details-marker {
    display: none;
  }

  .site-header_chevron {
    width: 1rem;
    height: 1rem;
    display: block;
    transition: transform var(--hover-duration) var(--hover-ease);
  }

  .site-header_wrap[data-tone="dark"] .site-header_chevron {
    filter: invert(1);
  }

  .site-header_dropdown[open] .site-header_chevron {
    transform: rotate(180deg);
  }

  /* Ocultar seguidores de cursor o botones flotantes del hero cuando el mega menú está activo */
  body:has(.site-header_dropdown[open]) .hero-red_follower,
  body:has(.site-header_wrap:hover) .hero-red_follower {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Cuando el dropdown de Sucursales está abierto: la barra entera se vuelve blanca continua, sin bordes */
  .site-header_wrap:has(.site-header_dropdown[open]) {
    background-color: var(--light-100) !important;
  }

  .site-header_wrap:has(.site-header_dropdown[open]) .site-header_logo--white {
    display: none !important;
  }

  .site-header_wrap:has(.site-header_dropdown[open]) .site-header_logo--dark {
    display: block !important;
  }

  .site-header_wrap:has(.site-header_dropdown[open]) .site-header_link {
    color: var(--dark-900) !important;
  }

  .site-header_wrap:has(.site-header_dropdown[open]) .site-header_chevron {
    filter: invert(1);
    transform: rotate(180deg);
  }

  /* Mega Menu Container - Pantalla completa, fondo blanco, CERO bordes, CERO sombras */
  .site-header_mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    background: var(--light-100);
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    padding-top: var(--space-3);
    padding-bottom: var(--space-6);
    padding-inline: var(--site-margin);
    box-sizing: border-box;
    z-index: 100;
    pointer-events: auto;
  }

  .mega-menu_inner {
    width: 100%;
    max-width: var(--max-width-main);
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* Grid de 4 Columnas con variable --space-4 */
  .mega-menu_grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    width: 100%;
    box-sizing: border-box;
  }

  /* Columnas 1, 2, 3: Tarjeta grande */
  .mega-menu_card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--dark-900);
    box-shadow: none !important;
  }

  .mega-menu_media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-small);
    overflow: hidden;
    background: var(--light-200);
    box-shadow: none !important;
  }

  .mega-menu_img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--hover-duration) var(--hover-ease);
  }

  @media (hover: hover) {
    .mega-menu_card:hover .mega-menu_img {
      transform: scale(1.04);
    }
  }

  /* Textos: gap de 4px con variable oficial, reseteando text-box trim para preservar leading real */
  .mega-menu_info,
  .mega-menu_list-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-0-5);
  }

  .mega-menu_city,
  .mega-menu_list-title {
    font-family: var(--font-headline);
    font-size: var(--text-eyebrow);
    font-weight: var(--primary-bold);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--dark-900);
    text-box: normal;
    text-box-trim: none;
  }

  .mega-menu_desc,
  .mega-menu_list-desc {
    font-size: var(--text-caption);
    color: var(--dark-700);
    text-box: normal;
    text-box-trim: none;
  }

  /* Columna 4: Lista apilada con sus divisores limpios de 1px */
  .mega-menu_col--list {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: var(--space-2);
  }

  .mega-menu_list-item {
    display: grid;
    grid-template-columns: 5.25rem 1fr;
    gap: var(--space-3);
    align-items: center;
    text-decoration: none;
    color: var(--dark-900);
    padding-block: var(--space-1);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    transition: background-color var(--hover-duration) var(--hover-ease);
  }

  .mega-menu_list-item:first-child {
    padding-top: 0;
  }

  .mega-menu_list-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .mega-menu_list-thumb {
    width: 5.25rem;
    height: 3.25rem;
    border-radius: var(--radius-small);
    overflow: hidden;
    background: var(--light-200);
    flex-shrink: 0;
  }

  .mega-menu_list-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--hover-duration) var(--hover-ease);
  }

  @media (hover: hover) {
    .mega-menu_list-item:hover .mega-menu_list-thumb img {
      transform: scale(1.05);
    }
  }

  /* 3. Herramientas a la Derecha */
  .site-header_tools {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    pointer-events: auto;
  }

  /* Botón Carrito Sticker Amarillo (Figma Node 219:612) - Variante de Button.astro */
  .site-header_wrap[data-tone="dark"] .site-header_cart {
    --button-shadow-color: #000000;
  }

  /* Botón Menú Burger (solo visible en pantallas < 1024px) */
  .site-header_toggle {
    --toggle-shadow-color: #ffffff;
    display: none;
    align-items: center;
    gap: 0.6rem;
    padding: 8px 14px;
    background-color: #ffe239;
    border: 1.5px solid #000000;
    border-radius: 6px;
    box-shadow: -4px 4px 0px var(--toggle-shadow-color);
    color: #000000;
    font-family: var(--font-headline);
    font-size: 1rem;
    font-weight: 800;
    cursor: pointer;
    user-select: none;
    transition:
      transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 160ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .site-header_wrap[data-tone="dark"] .site-header_toggle {
    --toggle-shadow-color: #000000;
  }

  @media (hover: hover) {
    .site-header_toggle:hover {
      transform: translate(-4px, 4px);
      box-shadow: 0 0 0 transparent;
    }
  }

  .site-header_toggle:active {
    transform: translate(-4px, 4px);
    box-shadow: 0 0 0 transparent;
  }

  .site-header_burger {
    width: 1.25rem;
    height: 0.95rem;
    position: relative;
    display: block;
  }

  .site-header_burger i {
    position: absolute;
    height: 2px;
    width: 100%;
    background: currentColor;
    left: 0;
    top: 0.2rem;
    transition: transform 180ms ease;
  }

  .site-header_burger i:last-child {
    top: 0.65rem;
  }

  .site-header_toggle.is-open .site-header_burger i:first-child {
    transform: translateY(0.22rem) rotate(45deg);
  }

  .site-header_toggle.is-open .site-header_burger i:last-child {
    transform: translateY(-0.22rem) rotate(-45deg);
  }

  /* =========================================================
     RESPONSIVE BREAKPOINTS
     ========================================================= */
  @media (max-width: 1023px) {
    .site-header_wrap {
      padding-top: var(--space-3);
    }

    .site-header_primary {
      display: none; /* En tablet y móvil se abre con el menú drawer */
    }

    .site-header_bar {
      grid-template-columns: 1fr auto;
    }

    .site-header_tools {
      grid-column: 2;
    }

    .site-header_toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 480px) {
    .site-header_cart,
    .site-header_toggle {
      padding: 7px 11px;
      font-size: 0.875rem;
    }

    .site-header_logo {
      width: 96px;
      height: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header_wrap,
    .site-header_cart,
    .site-header_link {
      transition: none !important;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import "@/scripts/navigation.js";

  // Mega Menú Desktop Hover Intent + GSAP Choreographed Animation
  (() => {
    const dropdown = document.querySelector(".site-header_dropdown");
    if (!dropdown) return;

    const summary = dropdown.querySelector("summary");
    const megaMenu = dropdown.querySelector(".site-header_mega-menu");
    if (!megaMenu) return;

    const cards = Array.from(megaMenu.querySelectorAll(".mega-menu_card"));
    const listItems = Array.from(megaMenu.querySelectorAll(".mega-menu_list-item"));
    const allItems = [...cards, ...listItems];

    const isDesktop = () => window.innerWidth >= 1024;
    const prefersReducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let closeTimer = null;
    let isOpen = false;
    let isClosing = false;
    let closeTween = null;

    function openMenu() {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }

      if (isClosing) {
        if (closeTween) closeTween.kill();
        isClosing = false;
      }

      if (isOpen && dropdown.open) return;

      dropdown.open = true;
      isOpen = true;

      if (prefersReducedMotion()) {
        gsap.set(megaMenu, { autoAlpha: 1, y: 0 });
        gsap.set(allItems, { autoAlpha: 1, y: 0 });
        return;
      }

      // Kill active tweens
      gsap.killTweensOf([megaMenu, ...allItems]);

      // Initial state
      gsap.set(megaMenu, { autoAlpha: 0, y: -10 });
      gsap.set(allItems, { autoAlpha: 0, y: 14 });

      // 1. Container entrance
      gsap.to(megaMenu, {
        autoAlpha: 1,
        y: 0,
        duration: 0.28,
        ease: "power2.out"
      });

      // 2. Internal elements staggered cascade (one by one)
      gsap.to(allItems, {
        autoAlpha: 1,
        y: 0,
        duration: 0.32,
        stagger: 0.045,
        delay: 0.04,
        ease: "power2.out"
      });
    }

    function closeMenu(immediate = false) {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }

      if (!dropdown.open && !isOpen) return;

      if (immediate || prefersReducedMotion()) {
        if (closeTween) closeTween.kill();
        dropdown.open = false;
        isOpen = false;
        isClosing = false;
        gsap.set(megaMenu, { autoAlpha: 0 });
        gsap.set(allItems, { autoAlpha: 1, y: 0 });
        return;
      }

      isClosing = true;
      gsap.killTweensOf([megaMenu, ...allItems]);

      closeTween = gsap.to(megaMenu, {
        autoAlpha: 0,
        y: -6,
        duration: 0.18,
        ease: "power2.in",
        onComplete: () => {
          dropdown.open = false;
          isOpen = false;
          isClosing = false;
          gsap.set(allItems, { autoAlpha: 1, y: 0 });
        }
      });
    }

    // Hover intent on desktop
    dropdown.addEventListener("mouseenter", () => {
      if (!isDesktop()) return;
      openMenu();
    });

    dropdown.addEventListener("mouseleave", () => {
      if (!isDesktop()) return;
      closeTimer = setTimeout(() => {
        closeMenu(false);
      }, 200);
    });

    // Toggle on summary click without browser jump
    if (summary) {
      summary.addEventListener("click", (e) => {
        if (isDesktop()) {
          e.preventDefault();
          if (isOpen && dropdown.open && !isClosing) {
            closeMenu(false);
          } else {
            openMenu();
          }
        }
      });
    }

    // Close on click outside
    document.addEventListener("click", (e) => {
      if (dropdown.open && !dropdown.contains(e.target)) {
        closeMenu(false);
      }
    });

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && dropdown.open) {
        closeMenu(false);
      }
    });

    // Instant close when clicking any navigation link inside mega menu
    dropdown.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu(true);
      });
    });
  })();
</script>
