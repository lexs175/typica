      <span>Café boliviano de especialidad.</span>
      <div>
        <a
          href="https://www.instagram.com/typica.cafe/"
          target="_blank"
          rel="noopener"
        >
          Instagram
        </a>
        <a
          href="https://linktr.ee/typicacafetostaduria"
          target="_blank"
          rel="noopener"
        >
          Hablemos
        </a>
        <button id="open-credits">Fotografías</button>
        <a href="/#inicio">Arriba</a>
