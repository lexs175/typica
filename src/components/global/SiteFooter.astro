<style is:global>
  @layer components {
    .site-footer_wrap {
      background: var(--yellow-400);
      position: relative;
      z-index: 1;
      padding: 5.3125rem var(--gutter) 2.5rem;
      overflow: hidden;
    }
    .site-footer_top {
      display: flex;
      justify-content: space-between;
      gap: 2.1875rem;
      align-items: flex-start;
    }
    .site-footer_top h2 {
      font-size: clamp(3.5rem, 7.5vw, 7.5rem);
      letter-spacing: -0.05em;
      line-height: 0.92;
      font-weight: 900;
    }
    .site-footer_nav {
      display: grid;
      grid-template-columns: repeat(3, minmax(8.75rem, 13.75rem));
      gap: 2.5rem;
      max-width: 61.25rem;
      margin-top: 3rem;
      margin-bottom: 3.125rem;
    }
    .site-footer_col {
      display: flex;
      flex-direction: column;
      gap: 0.875rem;
    }
    .site-footer_col-title {
      font-size: 0.6875rem;
      font-weight: 800;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.75;
    }
    .site-footer_col-links {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
    }
    .site-footer_col-links a {
      font-size: 1rem;
      font-weight: 700;
      color: var(--ink);
      text-decoration: none;
      width: fit-content;
      display: inline-block;
      transition:
        opacity 0.2s,
        text-decoration 0.2s;
    }
    .site-footer_col-links a:hover {
      opacity: 0.6;
      text-decoration: underline;
      text-underline-offset: 0.25rem;
    }
    .site-footer_word {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      width: 100%;
      margin-top: 1.875rem;
      line-height: 0;
      user-select: none;
    }
    .site-footer_word svg {
      height: clamp(3.4375rem, 11vw, 10.9375rem);
      width: auto;
      display: block;
      color: var(--ink);
    }
    .site-footer_bottom {
      display: flex;
      justify-content: space-between;
      gap: 1.5625rem;
      align-items: center;
      font-size: 0.84375rem;
      margin-top: 3.4375rem;
      padding-top: 1.5rem;
      border-top: 0.0625rem solid var(--border-soft);
      color: var(--overlay-dark);
    }
    .site-footer_bottom > div {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }
    .site-footer_bottom a,
    .site-footer_bottom button {
      font-size: 0.84375rem;
      color: var(--ink);
      text-decoration: none;
      transition: opacity 0.2s;
    }
    .site-footer_bottom a:hover,
    .site-footer_bottom button:hover {
      opacity: 0.55;
    }
    @media (max-width: 71.875rem) {
      .site-footer_bottom {
        flex-wrap: wrap;
      }
    }
    @media (max-width: 43.75rem) {
      .site-footer_wrap {
        padding: 3.4375rem 1.375rem 1.875rem;
      }
    }
    @media (max-width: 43.75rem) {
      .site-footer_top {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.375rem;
      }
    }
    @media (max-width: 43.75rem) {
      .site-footer_top h2 {
        font-size: clamp(3rem, 14vw, 4.75rem);
      }
    }
    @media (max-width: 43.75rem) {
      .site-footer_nav {
        grid-template-columns: 1fr 1fr;
        gap: 2rem 1.5rem;
        margin-top: 2.8125rem;
      }
    }
    @media (max-width: 43.75rem) {
      .site-footer_col:last-child {
        grid-column: span 2;
      }
    }
    @media (max-width: 43.75rem) {
      .site-footer_col-links a {
        font-size: 0.9375rem;
      }
    }
    @media (max-width: 43.75rem) {
      .site-footer_word {
        margin-top: 2.1875rem;
      }
    }
    @media (max-width: 43.75rem) {
      .site-footer_bottom {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
        font-size: 0.78125rem;
        margin-top: 2.5rem;
        padding-top: 1.25rem;
      }
    }
    @media (max-width: 43.75rem) {
      .site-footer_bottom > div {
        gap: 1rem;
        flex-wrap: wrap;
        margin: 0;
      }
    }
    @media (max-width: 43.75rem) {
      .site-footer_bottom button {
        font-size: 0.78125rem;
      }
    }
    .site-footer_bottom a > .inline-arrow {
      width: 1rem;
      height: 1rem;
    }
  }
</style>
