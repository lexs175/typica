---
interface Props {
  render?: boolean;
}
const { render = true } = Astro.props;
---

{render && (
  <div class="cart-notice_wrap" id="cart-notice" hidden>
    <span id="cart-notice-text" role="status"></span>
    <button id="cart-notice-open">Ver carrito</button>
    <button id="cart-notice-close" aria-label="Cerrar aviso">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="m6 6 12 12M18 6 6 18"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>
)}
<style is:global>
  @layer components {
    .cart-notice_wrap {
      position: fixed;
      z-index: 90;
      bottom: 1.5rem;
      left: var(--gutter);
      max-width: calc(100% - var(--gutter) * 2);
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding: 1rem 1.125rem;
      background: var(--yellow);
      color: var(--ink);
      font-size: 0.9375rem;
    }
    .cart-notice_wrap #cart-notice-open {
      text-decoration: underline;
      font-weight: 750;
      text-underline-offset: 0.25rem;
      white-space: nowrap;
    }
    @media (max-width: 40.625rem) {
      .cart-notice_wrap {
        left: 1.125rem;
        right: 1.125rem;
        max-width: none;
        bottom: 1.125rem;
        gap: 0.75rem;
        font-size: 0.8125rem;
        padding: 0.75rem;
      }
    }
  }
</style>
