---
import Button from "@/components/Button.astro";
import geshaImage from "@/assets/products/Image.png";

interface Props {
  render?: boolean;
}
const { render = true } = Astro.props;
---

{render && (
  <dialog class="cart-panel_wrap" id="cart-dialog" data-lenis-prevent aria-labelledby="cart-title">
    <div class="cart-panel_head">
      <h2 id="cart-title">
        Tu carrito<span class="cart-panel_head-count">0 bolsas</span>
      </h2>
      <button
        class="cart-panel_close"
        id="cart-close"
        aria-label="Cerrar carrito"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="m5 5 14 14M19 5 5 19"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
    <div class="cart-panel_empty" id="cart-empty">
      <img
        src={geshaImage.src}
        alt="Bolsa de café Gesha"
        width="480"
        height="480"
      />
      <h3>
        Un buen café
        <br />
        <em>Un buen comienzo</em>
      </h3>
      <p>Elige el que va contigo y guárdalo aquí.</p>
      <Button element="link" href="/#cafes">
        Descubrir los cafés
      </Button>
    </div>
    <div
      class="cart-panel_items"
      id="cart-items"
      role="list"
      aria-label="Bolsas en tu carrito"
    ></div>
    <div class="cart-panel_summary" id="cart-summary" hidden>
      <div class="cart-panel_subtotal">
        <span>Subtotal</span>
        <strong id="cart-total">Bs 0</strong>
      </div>
      <p class="cart-panel_demo-note">
        Precios de muestra. Consulta disponibilidad y entrega con Typica.
      </p>
      <Button id="cart-copy">Copiar mi pedido</Button>
      <a
        class="cart-panel_contact"
        href="https://linktr.ee/typicacafetostaduria"
        target="_blank"
        rel="noopener"
      >
        Consultar con Typica
      </a>
    </div>
    <p id="cart-status" class="sr-only" role="status" aria-live="polite"></p>
  </dialog>
)}
<style is:global>
  @layer components {
    .cart-panel_wrap {
      position: fixed;
      inset: 0 0 0 auto;
      margin: 0;
      padding: 1.75rem;
      width: min(33.125rem, 100%);
      max-width: 100%;
      height: 100dvh;
      max-height: 100dvh;
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--white);
    }
    .cart-panel_wrap::backdrop {
      background: var(--shadow-strong);
    }
    .cart-panel_head {
      display: flex;
      justify-content: space-between;
      align-items: start;
      gap: 1.25rem;
      margin-bottom: 1.625rem;
    }
    .cart-panel_head h2 {
      font-size: 2.375rem;
      font-weight: 850;
      letter-spacing: -0.045em;
      line-height: 1.05;
    }
    .cart-panel_head-count {
      display: block;
      font-size: 0.9375rem;
      font-weight: 500;
      letter-spacing: 0;
      margin-top: 0.625rem;
    }
    .cart-panel_close {
      width: 2.75rem;
      height: 2.75rem;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      background: var(--yellow);
    }
    .cart-panel_close svg {
      width: 1.5625rem;
      height: 1.5625rem;
    }
    .cart-panel_empty {
      text-align: center;
      padding: 0.3125rem 0 2.1875rem;
    }
    .cart-panel_empty > img {
      width: min(15rem, 65%);
      height: 14.6875rem;
      object-fit: contain;
      margin: 0 auto 1.25rem;
      transform: rotate(-7deg);
    }
    .cart-panel_empty h3 {
      font-size: 2.1875rem;
      line-height: 1.12;
      font-weight: 850;
      letter-spacing: -0.035em;
    }
    .cart-panel_empty h3 em {
      font-family: "Instrument Serif", Georgia, serif;
      font-weight: 400;
      font-size: 2.75rem;
    }
    .cart-panel_empty > p {
      font-size: 1rem;
      line-height: 1.5;
      margin: 1.25rem 0 1.625rem;
    }
    .cart-panel_item {
      display: grid;
      grid-template-columns: 6.25rem minmax(0, 1fr);
      gap: 1.25rem;
      padding: 1.375rem 0;
    }
    .cart-panel_item + .cart-panel_item {
      border-top: 0.0625rem solid var(--neutral-350);
    }
    .cart-panel_item-photo {
      display: grid;
      place-items: center;
      background: var(--warm-150);
      align-self: start;
      height: 8.25rem;
    }
    .cart-panel_item-photo img {
      width: 100%;
      height: 7.1875rem;
      object-fit: contain;
    }
    .cart-panel_item h3 {
      margin: 0;
      font-size: 1.6875rem;
      line-height: 1.1;
      letter-spacing: -0.035em;
    }
    .cart-panel_item p {
      margin: 0.5rem 0 0;
      font-size: 0.875rem;
      line-height: 1.45;
    }
    .cart-panel_item-tools {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-top: 0.9375rem;
    }
    .cart-panel_quantity {
      display: flex;
      align-items: center;
      background: var(--warm-150);
    }
    .cart-panel_quantity button {
      width: 2.5rem;
      height: 2.625rem;
      display: grid;
      place-items: center;
    }
    .cart-panel_quantity svg {
      width: 1rem;
      height: 1rem;
    }
    .cart-panel_quantity output {
      min-width: 1.5rem;
      text-align: center;
      font-size: 0.9375rem;
      font-variant-numeric: tabular-nums;
    }
    .cart-panel_quantity button:disabled {
      opacity: 0.35;
      cursor: default;
    }
    .cart-panel_remove {
      min-height: 2.625rem;
      font-size: 0.8125rem;
      text-decoration: underline;
      text-underline-offset: 0.25rem;
    }
    .cart-panel_item-price {
      font-weight: 750;
      font-size: 1.0625rem !important;
    }
    .cart-panel_summary {
      margin-top: 1.75rem;
      padding-top: 1.5rem;
      border-top: 0.125rem solid var(--ink);
    }
    .cart-panel_subtotal {
      display: flex;
      justify-content: space-between;
      gap: 1.25rem;
      align-items: center;
      font-size: 1.1875rem;
    }
    .cart-panel_subtotal strong {
      font-size: 1.75rem;
      letter-spacing: -0.03em;
    }
    .cart-panel_demo-note {
      font-size: 0.8125rem;
      line-height: 1.5;
      margin: 1rem 0 1.375rem;
    }
    .cart-panel_contact {
      display: block;
      text-align: center;
      padding: 1.125rem 0;
      font-size: 1rem;
      text-decoration: underline;
      text-underline-offset: 0.3125rem;
    }
    .cart-panel_wrap button:focus-visible,
    .cart-panel_wrap a:focus-visible {
      outline: 0.1875rem solid var(--ink);
      outline-offset: 0.1875rem;
    }
    .cart-panel_wrap [hidden],
    .cart-notice_wrap[hidden] {
      display: none !important;
    }
    @media (max-width: 40.625rem) {
      .cart-panel_wrap {
        padding: 1.5rem 1.25rem;
      }
    }
    @media (max-width: 40.625rem) {
      .cart-panel_head h2 {
        font-size: 2.0625rem;
      }
    }
    @media (max-width: 40.625rem) {
      .cart-panel_item {
        grid-template-columns: 5.125rem minmax(0, 1fr);
        gap: 0.9375rem;
      }
    }
    @media (max-width: 40.625rem) {
      .cart-panel_item-photo {
        height: 7.1875rem;
      }
    }
    @media (max-width: 40.625rem) {
      .cart-panel_item-photo img {
        height: 6.25rem;
      }
    }
    @media (max-width: 40.625rem) {
      .cart-panel_item h3 {
        font-size: 1.5rem;
      }
    }
  }
</style>

<script>
  import "@/scripts/coffee-shop.js";
</script>
