---
import granosImage from "@/assets/images/granos.avif";
import geshaImage from "@/assets/products/Image.png";
import frame1Sticker from "@/assets/stickers/Frame-1.svg";

interface Props {
  render?: boolean;
}
const { render = true } = Astro.props;
---

{render && (
  <div class="subscription-visual_wrap">
    <img
      class="subscription-visual_ground"
      src={granosImage.src}
      alt="Café boliviano recién tostado"
      width="1500"
      height="1500"
    />
    <img
      class="subscription-visual_pack"
      id="subscription-pack"
      src={geshaImage.src}
      alt="Bolsa de café Gesha de Typica"
      width="500"
      height="500"
    />
    <img
      class="subscription-visual_sticker"
      src={frame1Sticker.src}
      alt=""
      aria-hidden="true"
      width="130"
      height="130"
    />
    <p>
      Buen café.
      <br />
      Buena costumbre.
    </p>
  </div>
)}
<style is:global>
  @layer components {
    .subscription-visual_wrap {
      position: relative;
      isolation: isolate;
      display: flex;
      align-items: end;
      background: var(--green-700);
      color: var(--light-100);
      min-height: 56.25rem;
      overflow: hidden;
    }
    .subscription-visual_ground {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.3;
      z-index: -3;
    }
    .subscription-visual_pack {
      position: absolute;
      top: 11%;
      left: 3%;
      width: 94%;
      height: 65%;
      object-fit: contain;
      transform: rotate(-10deg);
      z-index: -2;
    }
    .subscription-visual_wrap > p {
      padding: 3.125rem;
      font-size: clamp(2rem, 3.5vw, 3.5rem);
      line-height: 1.1;
      font-weight: 650;
      letter-spacing: -0.05em;
    }
    .subscription-visual_wrap:after {
      content: "";
      position: absolute;
      inset: 45% 0 0;
      background: linear-gradient(0deg, var(--overlay-medium), transparent);
      z-index: -1;
      pointer-events: none;
    }
    .subscription-visual_sticker {
      position: absolute;
      width: 6.875rem;
      height: 6.875rem;
      right: 1.875rem;
      bottom: 18%;
      object-fit: contain;
      transform: rotate(10deg);
    }
    @media (max-width: 47.5rem) {
      .subscription-visual_wrap {
        min-height: 33.75rem;
      }
    }
    @media (max-width: 47.5rem) {
      .subscription-visual_pack {
        top: 17%;
        height: 65%;
      }
    }
    @media (max-width: 47.5rem) {
      .subscription-visual_wrap > p {
        padding: 1.875rem;
        font-size: 2rem;
      }
    }
    @media (max-width: 47.5rem) {
      .subscription-visual_sticker {
        width: 5.3125rem;
        height: 5.3125rem;
        right: 1.4375rem;
        bottom: 8%;
      }
    }
  }
</style>
